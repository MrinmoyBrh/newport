# ==============================================================================
# Portfolio CMS — Production Environment Variables Configuration Template
# Configure these variables in your Vercel Project Settings (Settings > Environment Variables).
# In local development, copy this file to .env.
# NEVER commit production passwords, connection strings, or secret keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# Enforces production mode, enabling HTTPS Secure cookie flags and performance optimizations.
NODE_ENV=production

# Disables Astro telemetry collection in serverless build and execution environments.
ASTRO_TELEMETRY_DISABLED=1

# ------------------------------------------------------------------------------
# 2. PERSISTENT DATABASE ENGINE (REQUIRED FOR VERCEL SERVERLESS)
# ------------------------------------------------------------------------------
# Local SQLite (data/portfolio.db) cannot persist writes on Vercel due to read-only
# ephemeral serverless lambdas. Connect a managed PostgreSQL database instance
# (e.g., Neon Serverless Postgres, Supabase, or Vercel Postgres).
# Provide either DATABASE_URL or POSTGRES_URL.
DATABASE_URL=postgres://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL=postgres://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Independent Postgres schema for Portfolio V2 isolation (defaults to portfolio_v2)
DATABASE_SCHEMA=portfolio_v2

# ------------------------------------------------------------------------------
# 3. DURABLE MEDIA & UPLOADS CLOUD STORAGE (RECOMMENDED)
# ------------------------------------------------------------------------------
# The local public/uploads directory is read-only in Vercel functions.
# Configure Vercel Blob storage to allow image uploads in the Admin CMS Media Library.
# Automatically provisioned when enabling the Vercel Blob Storage integration.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 4. CRYPTOGRAPHIC SESSION & SECURITY ENHANCEMENT (RECOMMENDED)
# ------------------------------------------------------------------------------
# 64-character cryptographically random secret string used for session hashing
# and HMAC token derivation. Generate with: openssl rand -hex 32
SESSION_SECRET=change_this_to_a_random_64_character_hex_string_in_production
