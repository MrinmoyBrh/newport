---
import InteractiveTerminal from './InteractiveTerminal.astro';
import { getModuleConfig } from '../lib/content';

let contact = {
  heading: "Let's build",
  subheading: 'resilient systems.',
  tagline: "Whether you are engineering a high-concurrency microservice cluster, architecting fault-tolerant queues, or seeking a dedicated backend engineer for internships or engineering roles—I'm ready to contribute.",
  email: 'mrinmoyborah360@gmail.com',
  githubUrl: 'https://github.com/MrinmoyBrh',
  linkedinUrl: 'https://www.linkedin.com/in/mrinmoy-borah-7771843b9/',
  status: 'Open for Backend Engineering Internships, Junior Backend Roles, & Collaborative Systems Engineering.',
};

try {
  const dbContact = await getModuleConfig('contact');
  if (dbContact) contact = { ...contact, ...dbContact };
} catch (e) {
  // Fallback
}
---

<section id="contact" class="py-24 sm:py-32 border-b border-[#E9DFCF]/10 relative overflow-hidden">
  
  <!-- Subtle Sage ambient glow -->
  <div class="absolute bottom-0 right-1/4 w-[450px] h-[450px] bg-[#9CAF88]/10 rounded-full blur-[140px] pointer-events-none -z-10" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- Left Column: Editorial Dispatch Invitation (5 cols) -->
      <div class="lg:col-span-5 flex flex-col justify-between">
        <div>
          <div class="flex items-center space-x-3 technical-mono text-xs text-[#9CAF88] mb-4">
            <span class="w-2 h-2 rounded-full bg-[#9CAF88] animate-pulse"></span>
            <span class="tracking-widest uppercase">TRANSMISSION DISPATCH // DIRECT COORDINATES</span>
          </div>

          <h2 class="font-brush text-4xl sm:text-5xl lg:text-6xl text-[#E9DFCF] mb-6 tracking-wide leading-snug">
            Let's build <span class="font-script text-[#C9BFAF] font-normal text-[1.08em]">resilient systems.</span>
          </h2>

          <p class="paragraph-manrope font-manrope text-[16px] sm:text-[17px] lg:text-[18px] text-[#C9BFAF] leading-[1.65] lg:leading-[1.7] tracking-[-0.01em] mb-8 font-normal">
            {contact.tagline}
          </p>

          <!-- Direct Coordinates Grid -->
          <div class="space-y-4 mb-8">
            
            <!-- Email Item with Copy Button -->
            <div class="p-5 bg-[#2B1D16]/80 border border-[#E9DFCF]/12 rounded-2xl flex items-center justify-between shadow-2xl backdrop-blur-md">
              <div class="flex items-center space-x-3.5">
                <div class="w-10 h-10 rounded-xl bg-[#9CAF88]/15 border border-[#9CAF88]/30 flex items-center justify-center text-[#9CAF88] shrink-0">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <span class="block text-[10px] technical-mono text-[#C9BFAF] uppercase tracking-wider">DIRECT INBOX</span>
                  <a
                    href={`mailto:${contact.email}`}
                    class="block text-xs sm:text-sm font-semibold technical-mono text-[#E9DFCF] hover:text-[#9CAF88] transition-colors"
                  >
                    {contact.email}
                  </a>
                </div>
              </div>

              <button
                id="copy-email-btn"
                type="button"
                data-email={contact.email}
                aria-label="Copy email address to clipboard"
                class="px-4 py-2 bg-[#1D1511] hover:bg-[#403027] text-[#C9BFAF] hover:text-[#E9DFCF] border border-[#E9DFCF]/15 rounded-full technical-mono text-xs transition-colors"
              >
                <span id="copy-text">COPY</span>
              </button>
            </div>

            <!-- Social Links Grid -->
            <div class="grid grid-cols-2 gap-4">
              <a
                href={contact.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="p-4 bg-[#2B1D16]/75 border border-[#E9DFCF]/10 hover:border-[#9CAF88]/40 rounded-2xl transition-colors flex items-center space-x-3 group shadow-xl backdrop-blur-md"
              >
                <div class="w-9 h-9 rounded-xl bg-[#1D1511] border border-[#E9DFCF]/10 flex items-center justify-center text-[#C9BFAF] group-hover:text-[#9CAF88] transition-colors">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                  </svg>
                </div>
                <div>
                  <span class="block text-[10px] technical-mono text-[#C9BFAF]/70">SOURCE REPOS</span>
                  <span class="block text-xs font-bold technical-mono text-[#E9DFCF] group-hover:text-[#9CAF88] transition-colors">GitHub ↗</span>
                </div>
              </a>

              <a
                href={contact.linkedinUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="p-4 bg-[#2B1D16]/75 border border-[#E9DFCF]/10 hover:border-[#9CAF88]/40 rounded-2xl transition-colors flex items-center space-x-3 group shadow-xl backdrop-blur-md"
              >
                <div class="w-9 h-9 rounded-xl bg-[#1D1511] border border-[#E9DFCF]/10 flex items-center justify-center text-[#C9BFAF] group-hover:text-[#9CAF88] transition-colors">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                  </svg>
                </div>
                <div>
                  <span class="block text-[10px] technical-mono text-[#C9BFAF]/70">PROFESSIONAL</span>
                  <span class="block text-xs font-bold technical-mono text-[#E9DFCF] group-hover:text-[#9CAF88] transition-colors">LinkedIn ↗</span>
                </div>
              </a>
            </div>

          </div>

          <div class="p-5 bg-[#2B1D16]/70 border border-[#E9DFCF]/10 rounded-2xl">
            <div class="flex items-center space-x-2 text-[11px] technical-mono text-[#C9BFAF] mb-1.5">
              <span class="w-2 h-2 rounded-full bg-[#9CAF88]"></span>
              <span class="text-[#9CAF88] font-semibold">AVAILABILITY STATUS</span>
            </div>
            <p class="text-xs text-[#E9DFCF] leading-relaxed">
              {contact.status}
            </p>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Terminal (7 cols) -->
      <div class="lg:col-span-7">
        <div class="mb-3 flex items-center justify-between text-xs technical-mono text-[#C9BFAF]">
          <span>// INTERACTIVE TELEMETRY TERMINAL</span>
          <span class="text-[#C9BFAF]/60">TRY: 'status', 'whoami', 'stack'</span>
        </div>
        <InteractiveTerminal />
      </div>

    </div>

  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyText = document.getElementById('copy-text');
  const email = 'mrinmoyborah360@gmail.com';

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(email);
      if (copyText) copyText.textContent = 'COPIED!';
      setTimeout(() => {
        if (copyText) copyText.textContent = 'COPY';
      }, 2000);
    } catch (err) {
      if (copyText) copyText.textContent = 'DONE';
    }
  });
</script>
