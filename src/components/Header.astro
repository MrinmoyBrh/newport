---
const navLinks = [
  { name: 'Systems', href: '#systems' },
  { name: 'Principles', href: '#principles' },
  { name: 'Architecture', href: '#architecture' },
  { name: 'Skills', href: '#skills' },
  { name: 'Experience', href: '#experience' },
  { name: 'Terminal', href: '#terminal' },
  { name: 'Contact', href: '#contact' },
];
---

<header class="sticky top-3 sm:top-5 z-50 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto transition-all duration-300">
  <!-- Floating Rounded Navigation Bar Container -->
  <div class="bg-[#2B1D16]/85 backdrop-blur-md border border-[#E9DFCF]/15 rounded-full shadow-[0_12px_36px_-6px_rgba(0,0,0,0.5)] px-3.5 sm:px-5 py-2 transition-all duration-300">
    <div class="flex items-center justify-between">
      
      <!-- Brand & Status Identity -->
      <div class="flex items-center space-x-3 sm:space-x-4">
        <a href="/" class="group flex items-center space-x-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#9CAF88] rounded-full p-0.5">
          <div class="relative flex-shrink-0 w-[36px] h-[36px] sm:w-[42px] sm:h-[42px] rounded-full overflow-hidden border border-[#E9DFCF]/20 group-hover:border-[#9CAF88] group-hover:shadow-[0_0_14px_rgba(156,175,136,0.45)] transition-all duration-300 bg-[#1D1511] flex items-center justify-center">
            <!-- Fallback avatar displaying "MB" if the image fails to load -->
            <span class="technical-mono text-xs font-bold text-[#9CAF88] select-none pointer-events-none" aria-hidden="true">MB</span>
            <img
              src="/mrinmoy.jpg"
              alt="Mrinmoy Borah"
              width="42"
              height="42"
              loading="eager"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover rounded-full"
              style="object-position: center 30%;"
              onerror="this.style.display = 'none';"
            />
          </div>
          <div class="pr-1">
            <span class="font-display font-semibold text-[#E9DFCF] text-xs sm:text-sm tracking-tight block group-hover:text-[#9CAF88] transition-colors">
              Mrinmoy Borah
            </span>
            <span class="technical-mono text-[10px] sm:text-[11px] text-[#C9BFAF] block tracking-wider uppercase">
              Backend Systems Eng.
            </span>
          </div>
        </a>

        <!-- Live Node Telemetry Indicator -->
        <div class="hidden xl:flex items-center space-x-2 pl-3 border-l border-[#E9DFCF]/10" aria-label="System status">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#9CAF88] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#9CAF88]"></span>
          </span>
          <span class="technical-mono text-[10.5px] text-[#C9BFAF] tracking-wider">
            STATUS: NOMINAL
          </span>
        </div>
      </div>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center space-x-0.5 lg:space-x-1" aria-label="Main Navigation">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="px-2.5 lg:px-3 py-1.5 text-xs lg:text-[13px] font-medium text-[#C9BFAF] hover:text-[#E9DFCF] hover:bg-[#E9DFCF]/5 rounded-full transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#9CAF88]"
          >
            {link.name}
          </a>
        ))}
      </nav>

      <!-- External Links & Direct Dispatch CTA -->
      <div class="hidden sm:flex items-center space-x-2">
        <a
          href="https://github.com/MrinmoyBrh"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub Profile"
          class="p-2 text-[#C9BFAF] hover:text-[#9CAF88] hover:bg-[#E9DFCF]/5 rounded-full transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#9CAF88]"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>

        <a
          href="https://www.linkedin.com/in/mrinmoy-borah-7771843b9/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn Profile"
          class="p-2 text-[#C9BFAF] hover:text-[#9CAF88] hover:bg-[#E9DFCF]/5 rounded-full transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#9CAF88]"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </a>

        <a
          href="#contact"
          class="inline-flex items-center px-4 py-2 text-xs font-semibold technical-mono rounded-full bg-[#9CAF88] hover:bg-[#B1C2A0] text-[#1D1511] transition-all duration-200 shadow-[0_2px_12px_rgba(156,175,136,0.3)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#9CAF88]"
        >
          GET IN TOUCH
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-2 rounded-full text-[#C9BFAF] hover:text-[#E9DFCF] hover:bg-[#E9DFCF]/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#9CAF88]"
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Toggle mobile navigation menu"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Collapsible Menu (Warm Brown Floating Drawer) -->
  <div
    id="mobile-nav"
    class="hidden md:hidden mt-2 bg-[#2B1D16]/95 backdrop-blur-xl border border-[#E9DFCF]/15 rounded-2xl p-5 shadow-2xl space-y-2 transition-all duration-300"
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block px-3.5 py-2 text-sm font-medium text-[#C9BFAF] hover:text-[#E9DFCF] hover:bg-[#403027]/60 rounded-xl transition-colors mobile-link"
      >
        {link.name}
      </a>
    ))}
    <div class="pt-4 border-t border-[#E9DFCF]/10 flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <a href="https://github.com/MrinmoyBrh" target="_blank" rel="noopener noreferrer" class="text-xs technical-mono text-[#C9BFAF] hover:text-[#9CAF88]">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/mrinmoy-borah-7771843b9/" target="_blank" rel="noopener noreferrer" class="text-xs technical-mono text-[#C9BFAF] hover:text-[#9CAF88]">LinkedIn ↗</a>
      </div>
      <a href="#contact" class="px-4 py-2 text-xs technical-mono rounded-full bg-[#9CAF88] text-[#1D1511] font-bold mobile-link">
        CONTACT
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileNav = document.getElementById('mobile-nav');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  if (menuBtn && mobileNav) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileNav.classList.toggle('hidden');
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        menuBtn.setAttribute('aria-expanded', 'false');
        mobileNav.classList.add('hidden');
      });
    });
  }
</script>
