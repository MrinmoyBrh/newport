---
import { timeline as defaultTimeline } from '../data/experience';
import { getExperiences, getEducation } from '../lib/content';

let timeline = defaultTimeline;
try {
  const dbExperiences = await getExperiences(true);
  const dbEducation = await getEducation();

  if (dbExperiences.length > 0 || dbEducation.length > 0) {
    const combined: any[] = [];
    
    dbExperiences.forEach((exp: any) => {
      combined.push({
        period: exp.period,
        role: exp.role,
        organization: exp.company,
        location: exp.location,
        type: exp.type || 'Work Experience',
        description: exp.description,
        points: exp.responsibilities || [],
        techStack: exp.technologies || [],
        order: exp.display_order ?? 0,
      });
    });

    dbEducation.forEach((edu: any) => {
      combined.push({
        period: edu.period,
        role: `${edu.degree} in ${edu.field}`,
        organization: edu.institution,
        location: edu.location,
        type: 'Education',
        description: `${edu.status} candidate pursuing comprehensive foundations in software engineering and distributed computing.`,
        points: edu.details || [],
        techStack: ['Algorithms', 'Data Structures', 'OS', 'Database Systems', 'Networking'],
        order: edu.display_order ?? 0,
      });
    });

    if (combined.length > 0) {
      combined.sort((a, b) => a.order - b.order);
      timeline = combined;
    }
  }
} catch (e) {
  // Fail-safe database fallback
}
---

<section id="experience" class="py-24 sm:py-32 border-b border-[#E9DFCF]/10 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Editorial Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 sm:mb-20 pb-8 border-b border-[#E9DFCF]/10 gap-6">
      <div class="max-w-3xl">
        <div class="flex items-center space-x-3 technical-mono text-xs text-[#9CAF88] mb-4">
          <span class="w-2 h-2 rounded-full bg-[#9CAF88] animate-pulse"></span>
          <span class="tracking-widest uppercase">CHRONOLOGY // EDUCATION & ENGAGEMENTS</span>
        </div>
        <h2 class="font-brush text-4xl sm:text-5xl lg:text-6xl text-[#E9DFCF] tracking-wide">
          Experience & <span class="font-script text-[#C9BFAF] font-normal text-[1.08em]">Academia.</span>
        </h2>
      </div>
      <p class="paragraph-manrope font-manrope text-[16px] sm:text-[17px] lg:text-[18px] text-[#C9BFAF] max-w-md leading-[1.65] lg:leading-[1.7] tracking-[-0.01em] font-normal">
        My formal foundation at Dhemaji Engineering College alongside enterprise utility engineering at APGCL and collaborative research associated with NIT Silchar.
      </p>
    </div>

    <!-- Editorial Vertical Timeline -->
    <div class="space-y-16 relative">
      
      <!-- Continuous Vertical Hairline (Desktop) in Subtle Oat -->
      <div class="hidden lg:block absolute left-[240px] top-6 bottom-6 w-px bg-[#E9DFCF]/10" aria-hidden="true"></div>

      {timeline.map((item) => (
        <article class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start relative group">
          
          <!-- Left Column: Large Editorial Date & Status (4 cols) -->
          <div class="lg:col-span-4 lg:text-right lg:pr-12 relative">
            <span class="editorial-title text-3xl sm:text-4xl font-bold text-[#E9DFCF] block mb-1 group-hover:text-[#9CAF88] transition-colors">
              {item.period}
            </span>
            <div class="flex items-center lg:justify-end space-x-2 technical-mono text-xs text-[#9CAF88] font-semibold uppercase tracking-wider mb-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#9CAF88]"></span>
              <span>{item.type}</span>
            </div>
            <span class="text-xs technical-mono text-[#C9BFAF]/60 block">
              {item.location}
            </span>

            <!-- Timeline Node Indicator (Absolute centered on desktop line) -->
            <div class="hidden lg:flex absolute -right-[6px] top-3.5 w-3.5 h-3.5 rounded-full bg-[#1D1511] border-2 border-[#9CAF88] items-center justify-center group-hover:scale-125 transition-transform shadow-[0_0_8px_rgba(156,175,136,0.5)]">
              <div class="w-1.5 h-1.5 rounded-full bg-[#9CAF88]"></div>
            </div>
          </div>

          <!-- Right Column: Editorial Case Study Dossier (8 cols) -->
          <div class="lg:col-span-8 bg-[#2B1D16]/65 border border-[#E9DFCF]/12 rounded-2xl p-8 sm:p-10 relative shadow-2xl group-hover:border-[#9CAF88]/40 transition-all duration-300 backdrop-blur-md">
            
            <div class="mb-6">
              <h3 class="font-brush text-2xl sm:text-3xl text-[#E9DFCF] mb-2 leading-snug">
                {item.role}
              </h3>
              <h4 class="text-base sm:text-lg font-medium text-[#9CAF88] mb-4">
                {item.organization}
              </h4>
              <p class="paragraph-manrope font-manrope text-[16px] sm:text-[17px] text-[#C9BFAF] leading-[1.65] lg:leading-[1.7] tracking-[-0.01em]">
                {item.description}
              </p>
            </div>

            <!-- Accomplishment Details -->
            <ul class="space-y-3 mb-8 pb-8 border-b border-[#E9DFCF]/10" role="list">
              {item.points.map((pt) => (
                <li class="paragraph-manrope font-manrope flex items-start space-x-3 text-[14px] sm:text-[15px] text-[#C9BFAF] leading-[1.65] tracking-[-0.01em]">
                  <span class="text-[#9CAF88] font-bold shrink-0 mt-0.5">›</span>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>

            <!-- Tech Stack Tags -->
            <div class="flex flex-wrap gap-2 technical-mono text-xs text-[#C9BFAF]">
              {item.techStack.map((tech) => (
                <span class="px-3 py-1 bg-[#403027]/70 border border-[#E9DFCF]/10 text-[#C9BFAF] rounded-full">
                  {tech}
                </span>
              ))}
            </div>

          </div>

        </article>
      ))}

    </div>

  </div>
</section>
