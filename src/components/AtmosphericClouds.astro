---
import { getAppearanceSettings } from '../lib/content';

let cloudsConfig = {
  enabled: true,
  opacity: 0.16,
  blurPx: 120,
  speedMultiplier: 1.0,
  cloud1Color: '#9CAF88', // Sage Green
  cloud2Color: '#403027', // Warm Brown
  cloud3Color: '#B1C2A0', // Sage Hover / Light Sage
};

try {
  const app = await getAppearanceSettings(true);
  if (app?.cloudAnimation) {
    cloudsConfig = { ...cloudsConfig, ...app.cloudAnimation };
  }
} catch (e) {
  // Fallback
}
---

<!-- ==========================================================================
     Atmospheric Clouds Background — Portfolio V2
     Organic, randomized drifting cloud gradients in Deep Espresso (#1D1511),
     Warm Brown (#403027), Oat (#E9DFCF), and Sage Green (#9CAF88).
     ========================================================================== -->

{cloudsConfig.enabled && (
<div
  id="atmospheric-clouds-layer"
  class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none select-none -z-10 bg-[#1D1511]"
  aria-hidden="true"
>
  <!-- Dynamic Cloud Blobs Container (Stacking Layer 2: Animated blurred Sage Green & warm gradients) -->
  <div id="clouds-stage" class="absolute inset-0 w-full h-full overflow-hidden">
    
    <!-- CLOUD 1: Subtle Sage Green Ambient Drift (Hero & Upper Systems Zone) -->
    <div
      class="atmospheric-cloud cloud-sage"
      data-cloud-id="0"
      style="
        top: 4%;
        left: 6%;
        width: 820px;
        height: 740px;
        background: radial-gradient(circle at 45% 45%, rgba(156, 175, 136, 0.14) 0%, rgba(156, 175, 136, 0.06) 42%, rgba(64, 48, 39, 0.02) 65%, transparent 75%);
        filter: blur(100px);
        border-radius: 46% 54% 62% 38% / 42% 58% 42% 58%;
      "
    ></div>

    <!-- CLOUD 2: Warm Brown / Oat Mist (Mid-Upper Systems / Architecture Zone) -->
    <div
      class="atmospheric-cloud cloud-warm-brown"
      data-cloud-id="1"
      style="
        top: 18%;
        right: 6%;
        width: 880px;
        height: 820px;
        background: radial-gradient(circle at 50% 50%, rgba(64, 48, 39, 0.28) 0%, rgba(201, 191, 175, 0.05) 45%, transparent 75%);
        filter: blur(110px);
        border-radius: 58% 42% 38% 62% / 52% 48% 52% 48%;
      "
    ></div>

    <!-- CLOUD 3: Soft Sage Green Light Glow (Architecture & Principles Zone) -->
    <div
      class="atmospheric-cloud cloud-sage"
      data-cloud-id="2"
      style="
        top: 36%;
        left: 12%;
        width: 840px;
        height: 780px;
        background: radial-gradient(circle at 50% 50%, rgba(177, 194, 160, 0.12) 0%, rgba(156, 175, 136, 0.05) 42%, transparent 70%);
        filter: blur(105px);
        border-radius: 40% 60% 55% 45% / 48% 42% 58% 52%;
      "
    ></div>

    <!-- CLOUD 4: Warm Brown Atmospheric Mist (Principles & Skills Zone) -->
    <div
      class="atmospheric-cloud cloud-warm-brown"
      data-cloud-id="3"
      style="
        top: 50%;
        right: 10%;
        width: 920px;
        height: 860px;
        background: radial-gradient(circle at 55% 45%, rgba(64, 48, 39, 0.25) 0%, rgba(201, 191, 175, 0.04) 45%, transparent 70%);
        filter: blur(115px);
        border-radius: 52% 48% 44% 56% / 46% 54% 46% 54%;
      "
    ></div>

    <!-- CLOUD 5: Sage Green Soft Pulse (Timeline / Experience Zone) -->
    <div
      class="atmospheric-cloud cloud-sage"
      data-cloud-id="4"
      style="
        top: 68%;
        left: 5%;
        width: 820px;
        height: 760px;
        background: radial-gradient(circle at 45% 55%, rgba(156, 175, 136, 0.13) 0%, rgba(64, 48, 39, 0.06) 40%, transparent 70%);
        filter: blur(110px);
        border-radius: 44% 56% 60% 40% / 50% 45% 55% 50%;
      "
    ></div>

    <!-- CLOUD 6: Warm Neutral Oat Drift (Terminal & Contact Zone) -->
    <div
      class="atmospheric-cloud cloud-warm-brown"
      data-cloud-id="5"
      style="
        top: 84%;
        right: 8%;
        width: 940px;
        height: 870px;
        background: radial-gradient(circle at 50% 50%, rgba(64, 48, 39, 0.28) 0%, rgba(156, 175, 136, 0.05) 45%, transparent 70%);
        filter: blur(120px);
        border-radius: 60% 40% 48% 52% / 54% 46% 54% 46%;
      "
    ></div>

    <!-- CLOUD 7: Subtle Sage Green Horizon Drift (Footer Edge) -->
    <div
      class="atmospheric-cloud cloud-sage"
      data-cloud-id="6"
      style="
        top: 94%;
        left: 26%;
        width: 780px;
        height: 700px;
        background: radial-gradient(circle at 50% 50%, rgba(156, 175, 136, 0.11) 0%, rgba(64, 48, 39, 0.05) 45%, transparent 70%);
        filter: blur(100px);
        border-radius: 50% 50% 58% 42% / 46% 54% 46% 54%;
      "
    ></div>

  </div>

  <!-- Background vignette anchoring Deep Espresso tone -->
  <div class="absolute inset-0 bg-[#1D1511]/35 pointer-events-none z-10"></div>

  <!-- Stacking Layer 3: Subtle frosted-glass overlay (blurs and saturates clouds beneath) -->
  <div class="absolute inset-0 glass-backdrop-overlay pointer-events-none z-20" aria-hidden="true"></div>

  <!-- Stacking Layer 4: Sharp, semi-transparent grid lines (sitting in front of glass so lines remain crisp!) -->
  <div class="absolute inset-0 tech-grid-bg pointer-events-none z-30" aria-hidden="true"></div>
</div>

<style>
  .atmospheric-cloud {
    position: absolute;
    will-change: transform, opacity;
    pointer-events: none;
    mix-blend-mode: screen;
  }
</style>

<script>
  (function initAtmosphericClouds() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    const clouds = document.querySelectorAll<HTMLElement>('.atmospheric-cloud');
    if (!clouds.length) return;

    const visitSeed = Math.floor(Math.random() * 0xFFFFFFFF);
    function mulberry32(seed: number) {
      return function () {
        let t = (seed += 0x6D2B79F5);
        t = Math.imul(t ^ (t >>> 15), t | 1);
        t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }
    const rng = mulberry32(visitSeed);

    interface CloudConfig {
      element: HTMLElement;
      baseX: number;
      baseY: number;
      driftRadiusX: number;
      driftRadiusY: number;
      speedX: number;
      speedY: number;
      speedScale: number;
      speedOpacity: number;
      phaseX: number;
      phaseY: number;
      phaseScale: number;
      phaseOpacity: number;
      baseScale: number;
      scaleRange: number;
      baseOpacity: number;
      opacityRange: number;
    }

    const configs: CloudConfig[] = [];

    clouds.forEach((cloud) => {
      const initialOffsetX = (rng() - 0.5) * 120;
      const initialOffsetY = (rng() - 0.5) * 90;
      
      const config: CloudConfig = {
        element: cloud,
        baseX: initialOffsetX,
        baseY: initialOffsetY,
        driftRadiusX: 60 + rng() * 80,
        driftRadiusY: 45 + rng() * 70,
        speedX: 0.00014 + rng() * 0.00018,
        speedY: 0.00012 + rng() * 0.00016,
        speedScale: 0.00018 + rng() * 0.00020,
        speedOpacity: 0.00015 + rng() * 0.00018,
        phaseX: rng() * Math.PI * 2,
        phaseY: rng() * Math.PI * 2,
        phaseScale: rng() * Math.PI * 2,
        phaseOpacity: rng() * Math.PI * 2,
        baseScale: 0.96 + rng() * 0.08,
        scaleRange: 0.10 + rng() * 0.08,
        baseOpacity: 0.8 + rng() * 0.15,
        opacityRange: 0.12 + rng() * 0.08,
      };

      configs.push(config);
    });

    let startTime = performance.now();
    let animationFrameId: number;

    function animateClouds(currentTime: number) {
      const elapsed = currentTime - startTime;

      for (let i = 0; i < configs.length; i++) {
        const c = configs[i];

        const dx = Math.sin(elapsed * c.speedX + c.phaseX) * c.driftRadiusX +
                   Math.sin(elapsed * (c.speedX * 0.5) + c.phaseY) * (c.driftRadiusX * 0.35);

        const dy = Math.cos(elapsed * c.speedY + c.phaseY) * c.driftRadiusY +
                   Math.cos(elapsed * (c.speedY * 0.6) + c.phaseX) * (c.driftRadiusY * 0.3);

        const scale = c.baseScale + Math.sin(elapsed * c.speedScale + c.phaseScale) * c.scaleRange;
        const opacity = Math.min(1, Math.max(0.4, c.baseOpacity + Math.sin(elapsed * c.speedOpacity + c.phaseOpacity) * c.opacityRange));

        c.element.style.transform = `translate3d(${dx.toFixed(2)}px, ${dy.toFixed(2)}px, 0) scale(${scale.toFixed(3)})`;
        c.element.style.opacity = opacity.toFixed(3);
      }

      animationFrameId = requestAnimationFrame(animateClouds);
    }

    animationFrameId = requestAnimationFrame(animateClouds);

    window.addEventListener('pagehide', () => {
      cancelAnimationFrame(animationFrameId);
    }, { once: true });
  })();
</script>
)}
