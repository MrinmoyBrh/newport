---
import { skillCategories as defaultCategories } from '../data/skills';
import { getFullSkillsMatrix } from '../lib/content';

let skillCategories = defaultCategories;
try {
  const dbMatrix = await getFullSkillsMatrix();
  if (dbMatrix && dbMatrix.length > 0) {
    const contextMap = new Map<string, string>();
    defaultCategories.forEach((cat) => {
      cat.skills.forEach((s) => contextMap.set(s.name, s.context));
    });

    skillCategories = dbMatrix.map((cat, idx) => {
      const fallbackCat = defaultCategories[idx] || defaultCategories[0];
      return {
        id: cat.id,
        code: fallbackCat?.code || `MOD_0${idx + 1} // DOMAIN`,
        title: cat.title || fallbackCat.title,
        tagline: cat.description || fallbackCat.tagline,
        skills: cat.skills.map((s: any) => ({
          name: s.name,
          context: s.description || contextMap.get(s.name) || `${s.proficiency || 'Practiced'} Engineering`,
          highlight: Boolean(s.is_highlighted),
        })),
      };
    });
  }
} catch (e) {
  // Fail-safe database fallback
}
---

<section id="skills" class="py-24 sm:py-32 border-b border-[#E9DFCF]/10 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Editorial Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 sm:mb-20 pb-8 border-b border-[#E9DFCF]/10 gap-6">
      <div class="max-w-3xl">
        <div class="flex items-center space-x-3 technical-mono text-xs text-[#9CAF88] mb-4">
          <span class="w-2 h-2 rounded-full bg-[#9CAF88] animate-pulse"></span>
          <span class="tracking-widest uppercase">TECHNICAL CAPABILITIES // SYSTEM MATRIX</span>
        </div>
        <h2 class="font-brush text-4xl sm:text-5xl lg:text-6xl text-[#E9DFCF] tracking-wide">
          Architectural <span class="font-script text-[#C9BFAF] font-normal text-[1.08em]">Competencies.</span>
        </h2>
      </div>
      <p class="paragraph-manrope font-manrope text-[16px] sm:text-[17px] lg:text-[18px] text-[#C9BFAF] max-w-md leading-[1.65] lg:leading-[1.7] tracking-[-0.01em] font-normal">
        A realistic summary of my technical competencies—spanning backend web development, programming languages, cloud fundamentals, developer tooling, and containerized code execution.
      </p>
    </div>

    <!-- Asymmetrical Editorial Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Flagship Module: Backend & Web Development (Spans 7 cols) -->
      {(() => {
        const flagship = skillCategories[0];
        return (
          <div class="lg:col-span-7 bg-[#2B1D16]/70 border border-[#E9DFCF]/12 rounded-3xl p-8 sm:p-10 relative shadow-2xl backdrop-blur-md">
            <!-- Subtle Sage backlight -->
            <div class="absolute -top-10 -right-10 w-48 h-48 bg-[#9CAF88]/10 blur-3xl pointer-events-none"></div>

            <div class="flex items-center justify-between pb-4 mb-6 border-b border-[#E9DFCF]/10 technical-mono text-xs">
              <span class="text-[#9CAF88] font-bold">{flagship.code}</span>
              <span class="text-[#C9BFAF]/60 uppercase tracking-wider">CORE FOCUS</span>
            </div>

            <h3 class="font-brush text-2xl sm:text-3xl text-[#E9DFCF] mb-2 leading-snug">
              {flagship.title}
            </h3>
            <p class="paragraph-manrope font-manrope text-[15px] sm:text-[16px] text-[#C9BFAF] mb-8 max-w-xl leading-[1.65] tracking-[-0.01em]">
              {flagship.tagline}
            </p>

            <div class="space-y-3.5">
              {flagship.skills.map((skill) => (
                <div class="p-4 bg-[#1D1511]/80 border border-[#E9DFCF]/10 rounded-xl hover:border-[#9CAF88]/40 transition-colors flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
                  <div class="flex items-center space-x-2.5">
                    {skill.highlight ? (
                      <span class="w-2 h-2 rounded-full bg-[#9CAF88] shrink-0"></span>
                    ) : (
                      <span class="w-1.5 h-1.5 rounded-full bg-[#E9DFCF]/30 shrink-0"></span>
                    )}
                    <span class="technical-mono text-xs sm:text-sm font-semibold text-[#E9DFCF]">
                      {skill.name}
                    </span>
                  </div>
                  <span class="text-[11px] sm:text-xs text-[#C9BFAF] technical-mono sm:text-right max-w-sm">
                    {skill.context}
                  </span>
                </div>
              ))}
            </div>
          </div>
        );
      })()}

      <!-- Second Module: Backend Runtimes & Frameworks (Spans 5 cols) -->
      {(() => {
        const mod2 = skillCategories[1];
        return (
          <div class="lg:col-span-5 bg-[#2B1D16]/70 border border-[#E9DFCF]/12 rounded-3xl p-8 sm:p-10 relative shadow-2xl backdrop-blur-md">
            <div class="flex items-center justify-between pb-4 mb-6 border-b border-[#E9DFCF]/10 technical-mono text-xs">
              <span class="text-[#9CAF88] font-bold">{mod2.code}</span>
              <span class="text-[#C9BFAF]/60 uppercase tracking-wider">LANGUAGES</span>
            </div>

            <h3 class="font-brush text-2xl sm:text-3xl text-[#E9DFCF] mb-2 leading-snug">
              {mod2.title}
            </h3>
            <p class="paragraph-manrope font-manrope text-[15px] sm:text-[16px] text-[#C9BFAF] mb-8 leading-[1.65] tracking-[-0.01em]">
              {mod2.tagline}
            </p>

            <div class="space-y-3">
              {mod2.skills.map((skill) => (
                <div class="py-3 border-b border-[#E9DFCF]/10 flex items-start justify-between gap-3">
                  <div class="flex items-center space-x-2">
                    {skill.highlight ? (
                      <span class="w-1.5 h-1.5 rounded-full bg-[#9CAF88] shrink-0"></span>
                    ) : (
                      <span class="w-1.5 h-1.5 rounded-full bg-[#E9DFCF]/30 shrink-0"></span>
                    )}
                    <span class="technical-mono text-xs font-semibold text-[#E9DFCF]">
                      {skill.name}
                    </span>
                  </div>
                  <span class="text-[11px] text-[#C9BFAF] technical-mono text-right max-w-[220px]">
                    {skill.context}
                  </span>
                </div>
              ))}
            </div>
          </div>
        );
      })()}

      <!-- Three Equal Columns for Remaining Domains (Spans 4 cols each) -->
      {skillCategories.slice(2).map((cat) => (
        <div class="lg:col-span-4 bg-[#2B1D16]/65 border border-[#E9DFCF]/10 rounded-2xl p-7 sm:p-8 relative shadow-2xl flex flex-col justify-between backdrop-blur-md">
          <div>
            <div class="flex items-center justify-between pb-3 mb-5 border-b border-[#E9DFCF]/10 technical-mono text-xs">
              <span class="text-[#9CAF88] font-bold">{cat.code}</span>
              <span class="text-[#C9BFAF]/60 text-[10px]">TOOLKIT</span>
            </div>

            <h3 class="font-brush text-xl sm:text-2xl text-[#E9DFCF] mb-2 leading-snug">
              {cat.title}
            </h3>
            <p class="paragraph-manrope font-manrope text-[14px] sm:text-[15px] text-[#C9BFAF] mb-6 leading-[1.65] tracking-[-0.01em]">
              {cat.tagline}
            </p>

            <div class="space-y-3">
              {cat.skills.map((skill) => (
                <div class="py-2.5 border-t border-[#E9DFCF]/10">
                  <div class="flex items-center space-x-2 mb-1">
                    {skill.highlight ? (
                      <span class="w-1.5 h-1.5 rounded-full bg-[#9CAF88] shrink-0"></span>
                    ) : (
                      <span class="w-1.5 h-1.5 rounded-full bg-[#E9DFCF]/25 shrink-0"></span>
                    )}
                    <span class="technical-mono text-xs font-semibold text-[#E9DFCF]">
                      {skill.name}
                    </span>
                  </div>
                  <p class="text-[11px] text-[#C9BFAF] leading-snug pl-3.5">
                    {skill.context}
                  </p>
                </div>
              ))}
            </div>
          </div>

          <div class="mt-6 pt-3 border-t border-[#E9DFCF]/10 flex items-center justify-between text-[10px] technical-mono text-[#C9BFAF]/60">
            <span>DOMAIN // OVERVIEW</span>
            <span>FOUNDATIONS</span>
          </div>
        </div>
      ))}

    </div>

  </div>
</section>
