    <aside id="admin-sidebar" class="fixed top-0 bottom-0 left-0 w-64 bg-[#2B1D16] border-r border-[#E9DFCF]/10 z-50 flex flex-col transition-transform duration-300 -translate-x-full lg:translate-x-0">
      
      <!-- Brand Header -->
      <div class="h-16 px-5 border-b border-[#E9DFCF]/10 flex items-center justify-between">
