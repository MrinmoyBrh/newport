          </div>
        </div>
        <button id="logout-btn" title="Sign Out" class="p-1.5 text-[#C9BFAF] hover:text-[#D9776A] rounded-md hover:bg-[#403027] transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
        </button>
      </div>

    </aside>

    <!-- ============================================================
         MAIN CONTENT AREA & TOPBAR
         ============================================================ -->
    <div class="flex-1 lg:pl-64 flex flex-col min-w-0">
      
      <!-- Top Navigation Bar -->
      <header class="h-16 bg-[#2B1D16]/90 border-b border-[#E9DFCF]/10 sticky top-0 z-30 backdrop-blur-md px-4 sm:px-8 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <button id="open-sidebar-btn" class="lg:hidden p-1.5 text-[#C9BFAF] hover:text-[#E9DFCF] rounded-lg hover:bg-[#403027]">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
          <div>
            <h1 class="text-base sm:text-lg font-bold text-[#E9DFCF] leading-tight">{title}</h1>
            {subtitle && <p class="text-xs text-[#C9BFAF] hidden sm:block leading-none mt-0.5">{subtitle}</p>}
          </div>
        </div>

        <!-- Quick Access Actions -->
        <div class="flex items-center space-x-3 text-xs">
          <a
            href="/admin/preview"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3.5 py-1.5 rounded-lg bg-[#403027] hover:bg-[#523E33] border border-[#E9DFCF]/15 text-[#E9DFCF] font-medium transition-colors flex items-center space-x-1.5"
          >
            <span>Live Draft Preview</span>
            <svg class="w-3.5 h-3.5 text-[#9CAF88]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          </a>

          <a
            href="/"
            target="_blank"
            class="px-3.5 py-1.5 rounded-lg bg-[#9CAF88] hover:bg-[#B1C2A0] text-[#1D1511] font-bold transition-colors flex items-center space-x-1.5 shadow-sm"
          >
            <span>View Public Site</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>
      </header>

      <!-- Main Body Viewport -->
      <main class="flex-1 p-4 sm:p-8 max-w-7xl w-full mx-auto">
        <slot />
      </main>

    </div>

    <!-- Client Script for Sidebar Toggle & Logout -->
    <script>
      const sidebar = document.getElementById('admin-sidebar');
      const overlay = document.getElementById('sidebar-overlay');
      const openBtn = document.getElementById('open-sidebar-btn');
      const closeBtn = document.getElementById('close-sidebar-btn');
      const logoutBtn = document.getElementById('logout-btn');

      openBtn?.addEventListener('click', () => {
        sidebar?.classList.remove('-translate-x-full');
        overlay?.classList.remove('hidden');
      });

      closeBtn?.addEventListener('click', () => {
        sidebar?.classList.add('-translate-x-full');
        overlay?.classList.add('hidden');
      });

      overlay?.addEventListener('click', () => {
        sidebar?.classList.add('-translate-x-full');
        overlay?.classList.add('hidden');
      });

      logoutBtn?.addEventListener('click', async () => {
        if (confirm('Sign out of Portfolio CMS?')) {
          await fetch('/api/auth/logout', { method: 'POST' });
          window.location.href = '/admin/login';
        }
      });
    </script>
  </body>
</html>
