      /* Portfolio V2 Admin Color System */
      :root {
        --admin-bg: #1D1511;
        --admin-sidebar: #2B1D16;
        --admin-card: #2B1D16;
        --admin-card-elevated: #403027;
        --admin-accent: #9CAF88;
        --admin-accent-hover: #B1C2A0;
        --admin-text-primary: #E9DFCF;
        --admin-text-secondary: #C9BFAF;
        --admin-border: rgba(233, 223, 207, 0.12);
        --admin-success: #9CAF88;
        --admin-warning: #D9A74A;
        --admin-error: #D9776A;
      }
      body {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        background-color: var(--admin-bg);
        color: var(--admin-text-primary);
        margin: 0;
        overflow-x: hidden;
      }
      ::selection {
        background-color: #9CAF88;
        color: #1D1511;
      }
      :focus-visible {
        outline: 2px solid #9CAF88;
        outline-offset: 2px;
      }
      .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
        height: 6px;
      }
      .custom-scrollbar::-webkit-scrollbar-track {
        background: #2B1D16;
      }
      .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #403027;
        border-radius: 3px;
      }
      .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #523E33;
      }

      svg {
        display: inline-block;
        vertical-align: middle;
        flex-shrink: 0;
      }
      svg.w-3\.5, svg.w-3 { width: 0.875rem !important; height: 0.875rem !important; min-width: 0.875rem; }
      svg.w-4 { width: 1rem !important; height: 1rem !important; min-width: 1rem; }
      svg.w-5 { width: 1.25rem !important; height: 1.25rem !important; min-width: 1.25rem; }
      svg.w-6 { width: 1.5rem !important; height: 1.5rem !important; min-width: 1.5rem; }
      svg.w-7 { width: 1.75rem !important; height: 1.75rem !important; min-width: 1.75rem; }
      svg.w-8 { width: 2rem !important; height: 2rem !important; min-width: 2rem; }
    </style>
  </head>
  <body class="bg-[#1D1511] text-[#E9DFCF] min-h-screen flex antialiased">

    <!-- Mobile Drawer Overlay -->
    <div id="sidebar-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 hidden lg:hidden"></div>

    <!-- ============================================================
         PORTFOLIO V2 ADMIN SIDEBAR
