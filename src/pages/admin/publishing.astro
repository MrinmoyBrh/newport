---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAllDrafts, getRevisions } from '../../lib/content';

export const prerender = false;

const drafts = await getAllDrafts();
const recentRevisions = await getRevisions(undefined, 8);
---

<AdminLayout title="Publishing & Draft Workflows" subtitle="Review pending drafts, staging state & live deployments" activeNav="publishing">
  
  <div class="space-y-6">
    <!-- Header Banner -->
    <div class="bg-[#202020] border border-[#343434] rounded-xl p-5 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-base font-bold text-[#F5F5F5] flex items-center space-x-2">
          <span>Staging Engine & Release Pipeline</span>
          <span class={`px-2 py-0.5 rounded text-[11px] font-mono border ${drafts.length > 0 ? 'bg-[#F59E0B]/10 text-[#F59E0B] border-[#F59E0B]/30' : 'bg-[#22C55E]/10 text-[#22C55E] border-[#22C55E]/30'}`}>
            {drafts.length > 0 ? `${drafts.length} Unsaved Drafts Pending` : 'All Content Synchronized'}
          </span>
        </h2>
        <p class="text-xs text-[#929292] mt-1">Staged modifications are saved safely without affecting your live portfolio until you hit Publish.</p>
      </div>

      <div class="flex items-center space-x-2">
        <a href="/admin/preview" target="_blank" class="px-3.5 py-2 rounded-lg bg-[#282828] hover:bg-[#343434] text-xs text-[#F5F5F5] border border-[#343434] transition-colors flex items-center space-x-1.5">
          <span>Preview Drafts</span>
          <svg class="w-3.5 h-3.5 text-[#9CAF88]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
        </a>
        <button id="publish-all-btn" class="px-4 py-2 rounded-lg bg-[#9CAF88] hover:bg-[#B1C2A0] text-[#1D1511] font-bold text-xs transition-colors flex items-center space-x-1.5 shadow-sm">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span>Publish All Live</span>
        </button>
      </div>
    </div>

    <!-- Alert / Toast Banner -->
    <div id="status-toast" class="hidden p-4 rounded-xl border text-xs font-mono transition-all"></div>

    <!-- Active Drafts Queue -->
    <div class="bg-[#202020] border border-[#343434] rounded-xl p-6">
      <h3 class="text-xs font-mono uppercase tracking-wider text-[#929292] font-semibold mb-3">Pending Draft Entities</h3>
      
      {drafts.length === 0 ? (
        <div class="p-8 text-center text-xs text-[#929292] bg-[#191919] rounded-lg border border-[#343434]">
          <div class="w-10 h-10 rounded-full bg-[#22C55E]/10 text-[#22C55E] flex items-center justify-center mx-auto mb-2 border border-[#22C55E]/20">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          </div>
          <span class="font-semibold text-[#F5F5F5] block">Clean Staging State</span>
          <span class="text-[11px] text-[#929292]">There are currently no unpublished drafts. Public website is 100% up-to-date.</span>
        </div>
      ) : (
        <div class="space-y-3">
          {drafts.map((d: any) => (
            <div class="p-4 bg-[#191919] border border-[#343434] rounded-lg flex items-center justify-between">
              <div>
                <span class="font-bold text-xs text-[#F5F5F5] uppercase font-mono tracking-wider">{d.key} Section</span>
                <span class="text-[11px] text-[#929292] block mt-0.5">Last modified: {new Date(d.updated_at).toLocaleString()}</span>
              </div>
              <div class="flex items-center space-x-2">
                <a href={`/admin/${d.key}`} class="px-3 py-1.5 rounded-lg bg-[#282828] hover:bg-[#343434] text-xs text-[#F5F5F5] border border-[#343434] transition-colors">
                  Edit Draft
                </a>
                <button
                  class="publish-single-btn px-3 py-1.5 rounded-lg bg-[#9CAF88] hover:bg-[#B1C2A0] text-[#1D1511] font-bold text-xs transition-colors"
                  data-target={d.key}
                >
                  Publish {d.key}
                </button>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- Recent Published Revisions -->
    <div class="bg-[#202020] border border-[#343434] rounded-xl p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-xs font-mono uppercase tracking-wider text-[#929292] font-semibold">Recent Production Releases</h3>
        <a href="/admin/history" class="text-xs text-[#9CAF88] hover:underline font-mono">View Full History & Rollback →</a>
      </div>

      <div class="space-y-2.5">
        {recentRevisions.map((rev: any) => (
          <div class="p-3 bg-[#191919] border border-[#343434] rounded-lg flex items-center justify-between text-xs">
            <div class="flex items-center space-x-3">
              <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-[#282828] text-[#929292] border border-[#343434] uppercase">
                {rev.entity_type}
              </span>
              <div>
                <span class="font-medium text-[#F5F5F5] block">{rev.summary}</span>
                <span class="text-[10px] text-[#929292] font-mono">{new Date(rev.published_at).toLocaleString()} by @{rev.published_by}</span>
              </div>
            </div>
            <button
              class="rollback-btn px-2.5 py-1 rounded bg-[#282828] hover:bg-[#343434] text-[11px] text-[#929292] hover:text-[#F5F5F5] border border-[#343434] transition-colors font-mono"
              data-id={rev.id}
            >
              Rollback
            </button>
          </div>
        ))}
      </div>
    </div>

  </div>

  <script>
    const publishAllBtn = document.getElementById('publish-all-btn');
    const toast = document.getElementById('status-toast');

    function showToast(msg: string, isError = false) {
      if (!toast) return;
      toast.classList.remove('hidden', 'bg-[#22C55E]/10', 'text-[#22C55E]', 'border-[#22C55E]/30', 'bg-[#EF4444]/10', 'text-[#EF4444]', 'border-[#EF4444]/30');
      if (isError) {
        toast.classList.add('bg-[#EF4444]/10', 'text-[#EF4444]', 'border-[#EF4444]/30');
      } else {
        toast.classList.add('bg-[#22C55E]/10', 'text-[#22C55E]', 'border-[#22C55E]/30');
      }
      toast.textContent = msg;
      setTimeout(() => toast?.classList.add('hidden'), 4000);
    }

    async function triggerPublish(target = 'all') {
      try {
        const res = await fetch('/api/cms/publish', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ target }),
        });
        const json = await res.json();
        if (res.ok) {
          showToast(json.message || 'Published successfully!');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(json.error || 'Publish failed', true);
        }
      } catch (err: any) {
        showToast(err.message, true);
      }
    }

    publishAllBtn?.addEventListener('click', () => {
      if (confirm('Publish all pending draft changes live to the public website?')) {
        triggerPublish('all');
      }
    });

    document.querySelectorAll('.publish-single-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-target');
        if (target) triggerPublish(target);
      });
    });

    document.querySelectorAll('.rollback-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        if (!id || !confirm('Are you sure you want to rollback to this historical release snapshot?')) return;

        try {
          const res = await fetch('/api/cms/revisions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ revisionId: id }),
          });
          const json = await res.json();
          if (res.ok) {
            showToast('Snapshot restored successfully!');
            setTimeout(() => window.location.reload(), 1000);
          } else {
            showToast(json.error || 'Rollback failed', true);
          }
        } catch (err: any) {
          showToast(err.message, true);
        }
      });
    });
  </script>
</AdminLayout>