---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getHeroContent } from '../../lib/content';

export const prerender = false;

// Get draft if available, otherwise published
const hero = await getHeroContent(false);
---

<AdminLayout title="Hero Section Editor" subtitle="Visually edit typography, descriptions, buttons, and orbital telemetry." activeNav="hero">
  
  <div class="space-y-8">
    
    <!-- Action Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-xl bg-[#202020] border border-[#343434]">
      <div>
        <h2 class="text-sm font-bold text-[#F5F5F5]">Hero Section Content & Orbital Setup</h2>
        <p class="text-xs text-[#929292]">Changes can be saved as drafts or published directly to your live portfolio.</p>
      </div>
      <div class="flex items-center space-x-3">
        <button id="save-draft-btn" class="px-4 py-2 bg-[#282828] hover:bg-[#323232] border border-[#343434] text-[#F5F5F5] font-semibold text-xs rounded-lg transition-colors">
          Save Draft
        </button>
        <button id="publish-btn" class="px-5 py-2 bg-[#9CAF88] hover:bg-[#B1C2A0] text-[#1D1511] font-bold text-xs rounded-lg transition-colors shadow-sm shadow-[#9CAF88]/20 flex items-center space-x-1.5">
          <span>Publish to Live Portfolio</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
        </button>
      </div>
    </div>

    <!-- Feedback Banner -->
    <div id="status-toast" class="hidden p-4 rounded-xl text-xs font-semibold flex items-center justify-between"></div>

    <form id="hero-form" class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Left Column: Content Form (7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Metadata Badges Card -->
        <div class="bg-[#202020] border border-[#343434] rounded-2xl p-6 shadow-sm">
          <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-[#9CAF88] mb-4">Metadata Eyebrow Badges</h3>
          
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-semibold text-[#F5F5F5] mb-1.5">Role Eyebrow</label>
              <input type="text" id="role_badge" name="role_badge" value={hero.role_badge} class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3 py-2 text-xs text-[#F5F5F5] focus:outline-none focus:border-[#9CAF88]" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-[#F5F5F5] mb-1.5">Education Eyebrow</label>
              <input type="text" id="education_badge" name="education_badge" value={hero.education_badge} class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3 py-2 text-xs text-[#F5F5F5] focus:outline-none focus:border-[#9CAF88]" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-[#F5F5F5] mb-1.5">Institution Eyebrow</label>
              <input type="text" id="college_badge" name="college_badge" value={hero.college_badge} class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3 py-2 text-xs text-[#F5F5F5] focus:outline-none focus:border-[#9CAF88]" />
            </div>
          </div>
        </div>

        <!-- Typography & Headline Card -->
        <div class="bg-[#202020] border border-[#343434] rounded-2xl p-6 shadow-sm">
          <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-[#9CAF88] mb-4">Editorial Typography</h3>
          
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-5">
            <div>
              <label class="block text-xs font-semibold text-[#F5F5F5] mb-1.5">Headline Line 1</label>
              <input type="text" id="headline_line1" name="headline_line1" value={hero.headline_line1} class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3 py-2 text-xs text-[#F5F5F5] focus:outline-none focus:border-[#9CAF88]" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-[#F5F5F5] mb-1.5">Italic Serif Highlight</label>
              <input type="text" id="headline_highlight" name="headline_highlight" value={hero.headline_highlight} class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3 py-2 text-xs text-[#F5F5F5] focus:outline-none focus:border-[#9CAF88]" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-[#F5F5F5] mb-1.5">Gradient Anchor Word</label>
              <input type="text" id="headline_gradient" name="headline_gradient" value={hero.headline_gradient} class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3 py-2 text-xs text-[#F5F5F5] focus:outline-none focus:border-[#9CAF88]" />
            </div>
          </div>

          <!-- Description Paragraph -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="block text-xs font-semibold text-[#F5F5F5]">Hero Mission Statement Description</label>
              <span class="text-[10px] text-[#929292] font-mono">SUPPORTS &lt;strong&gt; HIGHLIGHTS</span>
            </div>
            <textarea
              id="description_html"
              name="description_html"
              rows="6"
              class="w-full bg-[#191919] border border-[#343434] rounded-lg p-3 text-xs text-[#F5F5F5] leading-relaxed focus:outline-none focus:border-[#9CAF88] font-sans"
            >{hero.description_html || hero.description}</textarea>
            <p class="text-[11px] text-[#929292] mt-1.5">
              Wrap key technical terms (e.g. <code>&lt;strong class="text-pearl font-medium"&gt;Laravel, PHP, Python, and MySQL&lt;/strong&gt;</code>) to preserve the public editorial highlights.
            </p>
          </div>
        </div>

        <!-- Buttons & CTAs Card -->
        <div class="bg-[#202020] border border-[#343434] rounded-2xl p-6 shadow-sm">
          <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-[#9CAF88] mb-4">Call-to-Action Buttons</h3>
          
          <div class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-[#F5F5F5] mb-1.5">Primary Button Label</label>
                <input type="text" id="cta_primary_label" name="cta_primary_label" value={hero.cta_primary_label} class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3 py-2 text-xs text-[#F5F5F5] focus:outline-none focus:border-[#9CAF88]" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-[#F5F5F5] mb-1.5">Primary Button Link</label>
                <input type="text" id="cta_primary_url" name="cta_primary_url" value={hero.cta_primary_url} class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3 py-2 text-xs text-[#F5F5F5] focus:outline-none focus:border-[#9CAF88]" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-[#F5F5F5] mb-1.5">Secondary Button Label</label>
                <input type="text" id="cta_secondary_label" name="cta_secondary_label" value={hero.cta_secondary_label} class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3 py-2 text-xs text-[#F5F5F5] focus:outline-none focus:border-[#9CAF88]" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-[#F5F5F5] mb-1.5">Secondary Button Link</label>
                <input type="text" id="cta_secondary_url" name="cta_secondary_url" value={hero.cta_secondary_url} class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3 py-2 text-xs text-[#F5F5F5] focus:outline-none focus:border-[#9CAF88]" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-[#F5F5F5] mb-1.5">Terminal Trigger Label</label>
                <input type="text" id="cta_terminal_label" name="cta_terminal_label" value={hero.cta_terminal_label} class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3 py-2 text-xs text-[#F5F5F5] focus:outline-none focus:border-[#9CAF88]" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-[#F5F5F5] mb-1.5">Terminal Trigger Link</label>
                <input type="text" id="cta_terminal_url" name="cta_terminal_url" value={hero.cta_terminal_url} class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3 py-2 text-xs text-[#F5F5F5] focus:outline-none focus:border-[#9CAF88]" />
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Orbital Telemetry & Live Draft Mirror (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Orbital Visualization Radar Tags -->
        <div class="bg-[#202020] border border-[#343434] rounded-2xl p-6 shadow-sm">
          <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-[#9CAF88] mb-4">Orbital Radar Telemetry</h3>
          
          <div class="space-y-4 text-xs">
            <div>
              <label class="block font-semibold text-[#F5F5F5] mb-1.5">Top-Left Coordinates Tag</label>
              <input type="text" id="orbital_radar_top_left" name="orbital_radar_top_left" value={hero.orbital_radar_top_left} class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3 py-2 text-xs font-mono text-[#F5F5F5] focus:outline-none focus:border-[#9CAF88]" />
            </div>

            <div>
              <label class="block font-semibold text-[#F5F5F5] mb-1.5">Top-Right Cluster Tag</label>
              <input type="text" id="orbital_radar_top_right" name="orbital_radar_top_right" value={hero.orbital_radar_top_right} class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3 py-2 text-xs font-mono text-[#F5F5F5] focus:outline-none focus:border-[#9CAF88]" />
            </div>

            <div>
              <label class="block font-semibold text-[#F5F5F5] mb-1.5">Bottom-Left Failover Tag</label>
              <input type="text" id="orbital_radar_bottom_left" name="orbital_radar_bottom_left" value={hero.orbital_radar_bottom_left} class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3 py-2 text-xs font-mono text-[#F5F5F5] focus:outline-none focus:border-[#9CAF88]" />
            </div>

            <div>
              <label class="block font-semibold text-[#F5F5F5] mb-1.5">Bottom-Right Latency Tag</label>
              <input type="text" id="orbital_radar_bottom_right" name="orbital_radar_bottom_right" value={hero.orbital_radar_bottom_right} class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3 py-2 text-xs font-mono text-[#F5F5F5] focus:outline-none focus:border-[#9CAF88]" />
            </div>

            <div class="grid grid-cols-2 gap-3 pt-3 border-t border-[#343434]/50">
              <div>
                <label class="block font-semibold text-[#F5F5F5] mb-1.5">Status Title</label>
                <input type="text" id="orbital_status_title" name="orbital_status_title" value={hero.orbital_status_title} class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3 py-2 text-xs font-mono text-[#F5F5F5] focus:outline-none focus:border-[#9CAF88]" />
              </div>
              <div>
                <label class="block font-semibold text-[#F5F5F5] mb-1.5">Status Reliability</label>
                <input type="text" id="orbital_status_reliability" name="orbital_status_reliability" value={hero.orbital_status_reliability} class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3 py-2 text-xs font-mono text-[#F5F5F5] focus:outline-none focus:border-[#9CAF88]" />
              </div>
            </div>
          </div>
        </div>

        <!-- Live Component Mirror Preview Card -->
        <div class="bg-[#141414] border border-[#343434] rounded-2xl p-6 shadow-sm">
          <div class="flex items-center justify-between mb-3 pb-2 border-b border-[#343434]/60">
            <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-[#929292]">LIVE DRAFT PREVIEW</span>
            <span class="text-[10px] font-mono text-[#22C55E]">SYNCHRONIZED</span>
          </div>

          <div class="p-5 rounded-xl bg-[#080808] border border-white/10 font-sans space-y-4">
            <div class="flex flex-wrap gap-2 text-[10px] font-mono">
              <span id="preview-role" class="px-2 py-0.5 rounded-full bg-[#9CAF88]/10 text-[#9CAF88] border border-[#9CAF88]/30">{hero.role_badge}</span>
              <span id="preview-edu" class="text-[#B4B4B4]">{hero.education_badge}</span>
            </div>

            <h4 class="text-2xl font-black text-[#F4F2EF] tracking-tight leading-tight">
              <span id="preview-line1">{hero.headline_line1}</span><br />
              <span id="preview-highlight" class="italic font-serif font-normal text-[#F4F2EF]">{hero.headline_highlight}</span><br />
              <span id="preview-gradient" class="text-[#9CAF88]">{hero.headline_gradient}</span>
            </h4>

            <div id="preview-desc" class="text-xs text-[#B4B4B4] leading-relaxed font-normal" set:html={hero.description_html || hero.description} />
          </div>
        </div>

      </div>

    </form>

  </div>

  <script>
    const saveDraftBtn = document.getElementById('save-draft-btn') as HTMLButtonElement;
    const publishBtn = document.getElementById('publish-btn') as HTMLButtonElement;
    const toast = document.getElementById('status-toast') as HTMLDivElement;

    function showToast(message: string, isError = false) {
      toast.classList.remove('hidden', 'bg-[#22C55E]/10', 'border-[#22C55E]/30', 'text-[#22C55E]', 'bg-[#EF4444]/10', 'border-[#EF4444]/30', 'text-[#EF4444]');
      if (isError) {
        toast.classList.add('bg-[#EF4444]/10', 'border', 'border-[#EF4444]/30', 'text-[#EF4444]');
      } else {
        toast.classList.add('bg-[#22C55E]/10', 'border', 'border-[#22C55E]/30', 'text-[#22C55E]');
      }
      toast.textContent = message;
      setTimeout(() => {
        toast.classList.add('hidden');
      }, 4000);
    }

    function getFormData() {
      const getVal = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement)?.value || '';
      return {
        role_badge: getVal('role_badge'),
        education_badge: getVal('education_badge'),
        college_badge: getVal('college_badge'),
        headline_line1: getVal('headline_line1'),
        headline_highlight: getVal('headline_highlight'),
        headline_gradient: getVal('headline_gradient'),
        description: getVal('description_html').replace(/<[^>]*>?/gm, ''), // Plain text stripped
        description_html: getVal('description_html'),
        cta_primary_label: getVal('cta_primary_label'),
        cta_primary_url: getVal('cta_primary_url'),
        cta_secondary_label: getVal('cta_secondary_label'),
        cta_secondary_url: getVal('cta_secondary_url'),
        cta_terminal_label: getVal('cta_terminal_label'),
        cta_terminal_url: getVal('cta_terminal_url'),
        orbital_radar_top_left: getVal('orbital_radar_top_left'),
        orbital_radar_top_right: getVal('orbital_radar_top_right'),
        orbital_radar_bottom_left: getVal('orbital_radar_bottom_left'),
        orbital_radar_bottom_right: getVal('orbital_radar_bottom_right'),
        orbital_status_title: getVal('orbital_status_title'),
        orbital_status_reliability: getVal('orbital_status_reliability'),
      };
    }

    // Live sync preview
    ['role_badge', 'education_badge', 'headline_line1', 'headline_highlight', 'headline_gradient', 'description_html'].forEach((id) => {
      document.getElementById(id)?.addEventListener('input', (e) => {
        const val = (e.target as any).value;
        if (id === 'role_badge') (document.getElementById('preview-role') as HTMLElement).textContent = val;
        if (id === 'education_badge') (document.getElementById('preview-edu') as HTMLElement).textContent = val;
        if (id === 'headline_line1') (document.getElementById('preview-line1') as HTMLElement).textContent = val;
        if (id === 'headline_highlight') (document.getElementById('preview-highlight') as HTMLElement).textContent = val;
        if (id === 'headline_gradient') (document.getElementById('preview-gradient') as HTMLElement).textContent = val;
        if (id === 'description_html') (document.getElementById('preview-desc') as HTMLElement).innerHTML = val;
      });
    });

    saveDraftBtn?.addEventListener('click', async () => {
      saveDraftBtn.disabled = true;
      saveDraftBtn.textContent = 'Saving Draft...';
      try {
        const res = await fetch('/api/cms/hero', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'draft', data: getFormData() }),
        });
        const d = await res.json();
        if (res.ok) {
          showToast('Draft staged successfully! You can review it in Live Preview.');
        } else {
          showToast(d.error || 'Failed to save draft', true);
        }
      } catch (err: any) {
        showToast(err.message, true);
      } finally {
        saveDraftBtn.disabled = false;
        saveDraftBtn.textContent = 'Save Draft';
      }
    });

    publishBtn?.addEventListener('click', async () => {
      if (!confirm('Publish these hero modifications directly to your live portfolio?')) return;
      publishBtn.disabled = true;
      publishBtn.innerHTML = '<span>Publishing...</span>';
      try {
        const res = await fetch('/api/cms/hero', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'publish', data: getFormData() }),
        });
        const d = await res.json();
        if (res.ok) {
          showToast('Hero section published to live website!');
        } else {
          showToast(d.error || 'Publish failed', true);
        }
      } catch (err: any) {
        showToast(err.message, true);
      } finally {
        publishBtn.disabled = false;
        publishBtn.innerHTML = '<span>Publish to Live Portfolio</span>';
      }
    });
  </script>

</AdminLayout>
