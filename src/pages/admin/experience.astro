---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getExperiences } from '../../lib/content';

export const prerender = false;

const experiences = await getExperiences(false);
---

<AdminLayout title="Experience Manager" subtitle="Curate work history, internships & technical contributions" activeNav="experience">
  
  <div class="space-y-6">
    <!-- Header Banner -->
    <div class="bg-[#202020] border border-[#343434] rounded-xl p-5 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-base font-bold text-[#F5F5F5] flex items-center space-x-2">
          <span>Work History & Internships</span>
          <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-[#9CAF88]/10 text-[#9CAF88] border border-[#9CAF88]/30">{experiences.length} Entries</span>
        </h2>
        <p class="text-xs text-[#929292] mt-1">Manage verified industry contributions, responsibilities, and technology stacks.</p>
      </div>
      <button id="add-exp-btn" class="px-3.5 py-2 rounded-lg bg-[#9CAF88] hover:bg-[#B1C2A0] text-[#1D1511] font-bold text-xs flex items-center justify-center space-x-1.5 transition-colors shadow-sm self-start md:self-auto">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        <span>Add Experience Entry</span>
      </button>
    </div>

    <!-- Alert / Toast Banner -->
    <div id="status-toast" class="hidden p-4 rounded-xl border text-xs font-mono transition-all"></div>

    <!-- Experience Cards Grid -->
    <div class="space-y-4">
      {experiences.map((exp: any, index: number) => (
        <div class="bg-[#202020] border border-[#343434] rounded-xl p-5 hover:border-[#444444] transition-colors" data-id={exp.id}>
          <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-4">
            
            <div class="space-y-2 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-[#282828] text-[#929292] border border-[#343434]">#{index + 1}</span>
                <h3 class="text-sm font-bold text-[#F5F5F5]">{exp.role}</h3>
                <span class="text-xs text-[#9CAF88] font-semibold">@ {exp.company}</span>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-[#22C55E]/10 text-[#22C55E] border border-[#22C55E]/30">{exp.status || 'Completed'}</span>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-[#282828] text-[#929292] border border-[#343434]">{exp.period}</span>
              </div>

              <div class="text-xs text-[#929292] flex items-center space-x-2">
                <span>{exp.location}</span>
                <span>•</span>
                <span>{exp.type}</span>
              </div>

              {exp.description && (
                <p class="text-xs text-[#F5F5F5]/80 leading-relaxed pt-1">{exp.description}</p>
              )}

              {exp.responsibilities && exp.responsibilities.length > 0 && (
                <div class="pt-2">
                  <div class="text-[11px] font-mono text-[#929292] uppercase tracking-wider mb-1">Key Deliverables:</div>
                  <ul class="list-disc list-inside space-y-1 text-xs text-[#F5F5F5]/80">
                    {exp.responsibilities.map((r: string) => (
                      <li class="pl-1 leading-relaxed">{r}</li>
                    ))}
                  </ul>
                </div>
              )}

              {exp.technologies && exp.technologies.length > 0 && (
                <div class="pt-2 flex flex-wrap gap-1.5">
                  {exp.technologies.map((t: string) => (
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-[#191919] border border-[#343434] text-[#929292]">{t}</span>
                  ))}
                </div>
              )}
            </div>

            <div class="flex items-center space-x-2 self-end lg:self-start">
              <button
                class="edit-exp-btn px-3 py-1.5 rounded-lg bg-[#282828] hover:bg-[#343434] text-xs text-[#F5F5F5] border border-[#343434] transition-colors"
                data-exp={JSON.stringify(exp)}
              >
                Edit
              </button>
              <button
                class="delete-exp-btn p-1.5 rounded-lg bg-[#282828] hover:bg-[#EF4444]/20 hover:text-[#EF4444] text-[#929292] border border-[#343434] transition-colors"
                data-id={exp.id}
                title="Delete Experience"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              </button>
            </div>

          </div>
        </div>
      ))}
    </div>

    <!-- Modal Form (Add / Edit) -->
    <div id="exp-modal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
      <div class="bg-[#191919] border border-[#343434] rounded-xl max-w-2xl w-full max-h-[90vh] flex flex-col shadow-2xl">
        <div class="p-4 border-b border-[#343434] flex items-center justify-between">
          <h3 id="modal-title" class="text-sm font-bold text-[#F5F5F5]">Add Experience Entry</h3>
          <button id="close-modal-btn" class="p-1 text-[#929292] hover:text-[#F5F5F5]">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <form id="exp-form" class="p-5 overflow-y-auto space-y-4 custom-scrollbar text-xs flex-1">
          <input type="hidden" id="exp-id" name="id" />

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-[#929292] font-mono text-[11px] mb-1">ROLE / TITLE *</label>
              <input type="text" id="exp-role" required class="w-full bg-[#202020] border border-[#343434] rounded-lg px-3 py-2 text-[#F5F5F5] focus:border-[#9CAF88] focus:outline-none" placeholder="e.g. Software Engineering Intern" />
            </div>
            <div>
              <label class="block text-[#929292] font-mono text-[11px] mb-1">ORGANIZATION / COMPANY *</label>
              <input type="text" id="exp-company" required class="w-full bg-[#202020] border border-[#343434] rounded-lg px-3 py-2 text-[#F5F5F5] focus:border-[#9CAF88] focus:outline-none" placeholder="e.g. Assam Power Generation Corporation Limited (APGCL)" />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label class="block text-[#929292] font-mono text-[11px] mb-1">LOCATION</label>
              <input type="text" id="exp-location" class="w-full bg-[#202020] border border-[#343434] rounded-lg px-3 py-2 text-[#F5F5F5] focus:border-[#9CAF88] focus:outline-none" placeholder="e.g. Assam, India" />
            </div>
            <div>
              <label class="block text-[#929292] font-mono text-[11px] mb-1">PERIOD *</label>
              <input type="text" id="exp-period" required class="w-full bg-[#202020] border border-[#343434] rounded-lg px-3 py-2 text-[#F5F5F5] focus:border-[#9CAF88] focus:outline-none" placeholder="e.g. 2026" />
            </div>
            <div>
              <label class="block text-[#929292] font-mono text-[11px] mb-1">STATUS</label>
              <select id="exp-status" class="w-full bg-[#202020] border border-[#343434] rounded-lg px-3 py-2 text-[#F5F5F5] focus:border-[#9CAF88] focus:outline-none">
                <option value="Completed">Completed</option>
                <option value="In Progress">In Progress</option>
                <option value="Upcoming">Upcoming</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-[#929292] font-mono text-[11px] mb-1">TYPE</label>
            <input type="text" id="exp-type" class="w-full bg-[#202020] border border-[#343434] rounded-lg px-3 py-2 text-[#F5F5F5] focus:border-[#9CAF88] focus:outline-none" placeholder="e.g. Internship / Full-time" value="Work Experience" />
          </div>

          <div>
            <label class="block text-[#929292] font-mono text-[11px] mb-1">GENERAL DESCRIPTION</label>
            <textarea id="exp-description" rows="2" class="w-full bg-[#202020] border border-[#343434] rounded-lg px-3 py-2 text-[#F5F5F5] focus:border-[#9CAF88] focus:outline-none" placeholder="Overview of organization and scope of work..."></textarea>
          </div>

          <div>
            <label class="block text-[#929292] font-mono text-[11px] mb-1">RESPONSIBILITIES / ACHIEVEMENTS (One per line)</label>
            <textarea id="exp-responsibilities" rows="4" class="w-full bg-[#202020] border border-[#343434] rounded-lg px-3 py-2 text-[#F5F5F5] font-mono text-[11px] focus:border-[#9CAF88] focus:outline-none" placeholder="Developed administrative dashboard using Laravel and MySQL&#10;Integrated automated notifications via PHPMailer"></textarea>
          </div>

          <div>
            <label class="block text-[#929292] font-mono text-[11px] mb-1">TECHNOLOGIES USED (Comma separated)</label>
            <input type="text" id="exp-technologies" class="w-full bg-[#202020] border border-[#343434] rounded-lg px-3 py-2 text-[#F5F5F5] font-mono text-[11px] focus:border-[#9CAF88] focus:outline-none" placeholder="Laravel, PHP, MySQL, Apache, Linux, PHPMailer" />
          </div>

          <div class="pt-3 border-t border-[#343434] flex items-center justify-end space-x-2">
            <button type="button" id="cancel-modal-btn" class="px-4 py-2 rounded-lg bg-[#282828] hover:bg-[#343434] text-xs text-[#929292] font-medium transition-colors">
              Cancel
            </button>
            <button type="submit" id="save-exp-btn" class="px-4 py-2 rounded-lg bg-[#9CAF88] hover:bg-[#B1C2A0] text-[#1D1511] font-bold text-xs transition-colors shadow-sm">
              Save Entry
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    const modal = document.getElementById('exp-modal');
    const form = document.getElementById('exp-form') as HTMLFormElement;
    const modalTitle = document.getElementById('modal-title');
    const toast = document.getElementById('status-toast');

    const addBtn = document.getElementById('add-exp-btn');
    const closeBtn = document.getElementById('close-modal-btn');
    const cancelBtn = document.getElementById('cancel-modal-btn');

    function showToast(msg: string, isError = false) {
      if (!toast) return;
      toast.classList.remove('hidden', 'bg-[#22C55E]/10', 'text-[#22C55E]', 'border-[#22C55E]/30', 'bg-[#EF4444]/10', 'text-[#EF4444]', 'border-[#EF4444]/30');
      if (isError) {
        toast.classList.add('bg-[#EF4444]/10', 'text-[#EF4444]', 'border-[#EF4444]/30');
      } else {
        toast.classList.add('bg-[#22C55E]/10', 'text-[#22C55E]', 'border-[#22C55E]/30');
      }
      toast.textContent = msg;
      setTimeout(() => toast?.classList.add('hidden'), 4000);
    }

    function openModal(data: any = null) {
      form.reset();
      if (data) {
        modalTitle!.textContent = 'Edit Experience Entry';
        (document.getElementById('exp-id') as HTMLInputElement).value = data.id || '';
        (document.getElementById('exp-role') as HTMLInputElement).value = data.role || '';
        (document.getElementById('exp-company') as HTMLInputElement).value = data.company || '';
        (document.getElementById('exp-location') as HTMLInputElement).value = data.location || '';
        (document.getElementById('exp-period') as HTMLInputElement).value = data.period || '';
        (document.getElementById('exp-status') as HTMLSelectElement).value = data.status || 'Completed';
        (document.getElementById('exp-type') as HTMLInputElement).value = data.type || 'Work Experience';
        (document.getElementById('exp-description') as HTMLTextAreaElement).value = data.description || '';
        (document.getElementById('exp-responsibilities') as HTMLTextAreaElement).value = (data.responsibilities || []).join('\n');
        (document.getElementById('exp-technologies') as HTMLInputElement).value = (data.technologies || []).join(', ');
      } else {
        modalTitle!.textContent = 'Add Experience Entry';
        (document.getElementById('exp-id') as HTMLInputElement).value = '';
        (document.getElementById('exp-type') as HTMLInputElement).value = 'Work Experience';
        (document.getElementById('exp-status') as HTMLSelectElement).value = 'Completed';
      }
      modal?.classList.remove('hidden');
    }

    addBtn?.addEventListener('click', () => openModal());
    closeBtn?.addEventListener('click', () => modal?.classList.add('hidden'));
    cancelBtn?.addEventListener('click', () => modal?.classList.add('hidden'));

    document.querySelectorAll('.edit-exp-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const raw = btn.getAttribute('data-exp');
        if (raw) openModal(JSON.parse(raw));
      });
    });

    document.querySelectorAll('.delete-exp-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        if (!id || !confirm('Permanently delete this experience entry?')) return;

        try {
          const res = await fetch(`/api/cms/experience?id=${id}`, { method: 'DELETE' });
          const json = await res.json();
          if (res.ok) {
            showToast('Experience deleted successfully!');
            setTimeout(() => window.location.reload(), 800);
          } else {
            showToast(json.error || 'Failed to delete', true);
          }
        } catch (e: any) {
          showToast(e.message, true);
        }
      });
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = (document.getElementById('exp-id') as HTMLInputElement).value;
      const role = (document.getElementById('exp-role') as HTMLInputElement).value;
      const company = (document.getElementById('exp-company') as HTMLInputElement).value;
      const location = (document.getElementById('exp-location') as HTMLInputElement).value;
      const period = (document.getElementById('exp-period') as HTMLInputElement).value;
      const status = (document.getElementById('exp-status') as HTMLSelectElement).value;
      const type = (document.getElementById('exp-type') as HTMLInputElement).value;
      const description = (document.getElementById('exp-description') as HTMLTextAreaElement).value;
      const respRaw = (document.getElementById('exp-responsibilities') as HTMLTextAreaElement).value;
      const techRaw = (document.getElementById('exp-technologies') as HTMLInputElement).value;

      const responsibilities = respRaw.split('\n').map((s) => s.trim()).filter(Boolean);
      const technologies = techRaw.split(',').map((s) => s.trim()).filter(Boolean);

      const payload: any = {
        role,
        company,
        location,
        period,
        status,
        type,
        description,
        responsibilities,
        technologies,
      };
      if (id) payload.id = id;

      try {
        const res = await fetch('/api/cms/experience', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const json = await res.json();
        if (res.ok) {
          showToast(json.message || 'Experience saved successfully!');
          modal?.classList.add('hidden');
          setTimeout(() => window.location.reload(), 800);
        } else {
          showToast(json.error || 'Failed to save', true);
        }
      } catch (err: any) {
        showToast(err.message, true);
      }
    });
  </script>
</AdminLayout>