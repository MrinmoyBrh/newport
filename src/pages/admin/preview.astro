---
import '../../styles/global.css';
import { getSessionUser } from '../../lib/auth';
import { getAllDrafts } from '../../lib/content';

export const prerender = false;

const user = await getSessionUser(Astro.cookies);
if (!user) {
  return Astro.redirect('/admin/login');
}

const drafts = await getAllDrafts();
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Live Draft Preview — Portfolio CMS</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
      :root {
        --admin-bg: #111111;
        --admin-border: #343434;
      }
      body {
        margin: 0;
        padding: 0;
        background-color: var(--admin-bg);
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        color: #F5F5F5;
        overflow: hidden;
        height: 100vh;
        display: flex;
        flex-direction: column;
      }
    </style>
  </head>
  <body>

    <!-- Top Preview Control Bar -->
    <header class="h-14 bg-[#191919] border-b border-[#343434] px-4 flex items-center justify-between text-xs shrink-0 z-30">
      
      <div class="flex items-center space-x-3">
        <a href="/admin" class="p-1.5 text-[#929292] hover:text-[#F5F5F5] rounded hover:bg-[#282828] transition-colors" title="Back to Dashboard">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        </a>
        <div class="flex items-center space-x-2">
          <span class="font-bold text-[#F5F5F5]">PREVIEW WORKSPACE</span>
          <span class={`px-2 py-0.5 rounded text-[10px] font-mono border ${drafts.length > 0 ? 'bg-[#F59E0B]/10 text-[#F59E0B] border-[#F59E0B]/30' : 'bg-[#22C55E]/10 text-[#22C55E] border-[#22C55E]/30'}`}>
            {drafts.length > 0 ? `${drafts.length} Staged Drafts` : 'Synchronized with Live'}
          </span>
        </div>
      </div>

      <!-- Viewport Device Size Switcher -->
      <div class="hidden sm:flex items-center space-x-1 bg-[#141414] border border-[#343434] rounded-lg p-1">
        <button id="view-desktop" class="px-2.5 py-1 rounded text-xs font-mono font-medium transition-colors bg-[#9CAF88] text-[#1D1511]">
          Desktop (100%)
        </button>
        <button id="view-tablet" class="px-2.5 py-1 rounded text-xs font-mono font-medium text-[#929292] hover:text-[#F5F5F5] transition-colors">
          Tablet (768px)
        </button>
        <button id="view-mobile" class="px-2.5 py-1 rounded text-xs font-mono font-medium text-[#929292] hover:text-[#F5F5F5] transition-colors">
          Mobile (390px)
        </button>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center space-x-2">
        <button id="reload-iframe-btn" class="p-1.5 rounded-lg bg-[#282828] hover:bg-[#343434] text-[#929292] hover:text-[#F5F5F5] border border-[#343434] transition-colors" title="Reload Preview Frame">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        </button>

        <a
          href="/?preview=draft"
          target="_blank"
          class="px-3 py-1.5 rounded-lg bg-[#282828] hover:bg-[#343434] text-[#F5F5F5] border border-[#343434] transition-colors flex items-center space-x-1"
        >
          <span>Open Direct</span>
          <svg class="w-3.5 h-3.5 text-[#9CAF88]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>

        <button
          id="publish-preview-btn"
          class="px-3.5 py-1.5 rounded-lg bg-[#9CAF88] hover:bg-[#B1C2A0] text-[#1D1511] font-bold transition-colors shadow-sm"
        >
          Publish All
        </button>
      </div>

    </header>

    <!-- Main Viewport Canvas -->
    <main class="flex-1 bg-[#0d0d0d] flex items-center justify-center p-3 overflow-hidden relative">
      <div id="frame-container" class="w-full h-full transition-all duration-300 flex items-center justify-center">
        <iframe
          id="preview-frame"
          src="/?preview=draft"
          class="w-full h-full bg-[#080808] rounded-xl border border-[#343434] shadow-2xl transition-all duration-300"
          title="Portfolio Preview"
        ></iframe>
      </div>
    </main>

    <script>
      const frame = document.getElementById('preview-frame') as HTMLIFrameElement;
      const container = document.getElementById('frame-container');
      const reloadBtn = document.getElementById('reload-iframe-btn');
      const publishBtn = document.getElementById('publish-preview-btn');

      const btnDesktop = document.getElementById('view-desktop');
      const btnTablet = document.getElementById('view-tablet');
      const btnMobile = document.getElementById('view-mobile');

      function resetButtons() {
        [btnDesktop, btnTablet, btnMobile].forEach((b) => {
          b?.classList.remove('bg-[#9CAF88]', 'text-black');
          b?.classList.add('text-[#929292]');
        });
      }

      btnDesktop?.addEventListener('click', () => {
        resetButtons();
        btnDesktop.classList.add('bg-[#9CAF88]', 'text-black');
        if (container) container.style.maxWidth = '100%';
      });

      btnTablet?.addEventListener('click', () => {
        resetButtons();
        btnTablet.classList.add('bg-[#9CAF88]', 'text-black');
        if (container) container.style.maxWidth = '768px';
      });

      btnMobile?.addEventListener('click', () => {
        resetButtons();
        btnMobile.classList.add('bg-[#9CAF88]', 'text-black');
        if (container) container.style.maxWidth = '390px';
      });

      reloadBtn?.addEventListener('click', () => {
        frame.src = `/?preview=draft&t=${Date.now()}`;
      });

      publishBtn?.addEventListener('click', async () => {
        if (!confirm('Publish all draft updates to the public portfolio?')) return;
        try {
          const res = await fetch('/api/cms/publish', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ target: 'all' }),
          });
          if (res.ok) {
            alert('All draft changes published live!');
            frame.src = `/?preview=draft&t=${Date.now()}`;
          } else {
            alert('Publishing encountered an error.');
          }
        } catch (e: any) {
          alert(e.message);
        }
      });
    </script>
  </body>
</html>