---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getFullSkillsMatrix } from '../../lib/content';

export const prerender = false;

const categories = await getFullSkillsMatrix();
---

<AdminLayout title="Skills & Architecture Editor" subtitle="Curate technical competencies, category modules, and verified proficiency levels." activeNav="skills">
  
  <div class="space-y-8">
    
    <!-- Action Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-xl bg-[#202020] border border-[#343434]">
      <div>
        <h2 class="text-sm font-bold text-[#F5F5F5]">Curated Skills & Architectural Competencies</h2>
        <p class="text-xs text-[#929292]">Manage technical competencies categorized across your public portfolio.</p>
      </div>
      <div>
        <button id="add-skill-modal-btn" class="px-4 py-2 bg-[#9CAF88] hover:bg-[#B1C2A0] text-[#1D1511] font-bold text-xs rounded-lg transition-colors shadow-sm shadow-[#9CAF88]/20 flex items-center space-x-1.5">
          <span>+ Add Skill</span>
        </button>
      </div>
    </div>

    <div id="toast" class="hidden p-3 rounded-lg text-xs font-semibold"></div>

    <!-- Skills Matrix Grid -->
    <div class="space-y-6">
      {categories.map((cat) => (
        <div class="bg-[#202020] border border-[#343434] rounded-2xl p-6 shadow-sm">
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#343434]/60">
            <div>
              <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-[#9CAF88]">{cat.title}</h3>
              <p class="text-xs text-[#929292] mt-0.5">{cat.description}</p>
            </div>
            <span class="text-[10px] font-mono text-[#929292]">{cat.skills.length} competencies</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {cat.skills.map((s: any) => (
              <div class="p-3.5 rounded-xl bg-[#191919] border border-[#343434] hover:border-[#444444] transition-all flex items-center justify-between gap-3 group">
                <div class="min-w-0">
                  <div class="flex items-center space-x-2">
                    <span class="text-xs font-bold text-[#F5F5F5] truncate">{s.name}</span>
                    {s.is_highlighted ? (
                      <span class="w-1.5 h-1.5 rounded-full bg-[#9CAF88]" title="Highlighted core technology"></span>
                    ) : null}
                  </div>
                  {s.description && (
                    <p class="text-[11px] text-[#929292] mt-0.5 line-clamp-2 leading-tight">{s.description}</p>
                  )}
                  <span class={`inline-block text-[10px] font-mono mt-1 px-1.5 py-0.2 rounded ${
                    s.proficiency === 'Advanced' ? 'bg-[#9CAF88]/15 text-[#9CAF88]' :
                    s.proficiency === 'Practiced' ? 'bg-[#22C55E]/15 text-[#22C55E]' :
                    s.proficiency === 'Familiar' ? 'bg-[#3B82F6]/15 text-[#3B82F6]' :
                    'bg-[#929292]/15 text-[#929292]'
                  }`}>
                    {s.proficiency}
                  </span>
                </div>

                <button data-delete-skill={s.id} class="p-1.5 text-[#555555] hover:text-[#EF4444] rounded opacity-0 group-hover:opacity-100 transition-all">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                </button>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Add Skill Modal Dialog -->
    <div id="skill-modal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
      <div class="bg-[#191919] border border-[#343434] rounded-2xl p-6 max-w-md w-full shadow-2xl space-y-4">
        <h3 class="text-sm font-bold text-[#F5F5F5]">Add New Skill Competency</h3>
        
        <div>
          <label class="block text-xs font-semibold text-[#F5F5F5] mb-1">Skill Name</label>
          <input type="text" id="modal-skill-name" placeholder="e.g. PostgreSQL Optimization" class="w-full bg-[#202020] border border-[#343434] rounded-lg px-3 py-2 text-xs text-[#F5F5F5] focus:outline-none focus:border-[#9CAF88]" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#F5F5F5] mb-1">Description / Context</label>
          <input type="text" id="modal-skill-desc" placeholder="e.g. Building server-side applications with TypeScript" class="w-full bg-[#202020] border border-[#343434] rounded-lg px-3 py-2 text-xs text-[#F5F5F5] focus:outline-none focus:border-[#9CAF88]" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#F5F5F5] mb-1">Target Category</label>
          <select id="modal-skill-cat" class="w-full bg-[#202020] border border-[#343434] rounded-lg px-3 py-2 text-xs text-[#F5F5F5]">
            {categories.map((c) => (
              <option value={c.id}>{c.title}</option>
            ))}
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#F5F5F5] mb-1">Proficiency Level</label>
          <select id="modal-skill-prof" class="w-full bg-[#202020] border border-[#343434] rounded-lg px-3 py-2 text-xs text-[#F5F5F5]">
            <option value="Basic">Basic (Fundamentals)</option>
            <option value="Familiar">Familiar</option>
            <option value="Practiced" selected>Practiced (Hands-on)</option>
            <option value="Advanced">Advanced (Core)</option>
          </select>
        </div>

        <div class="flex items-center space-x-2 pt-1">
          <input type="checkbox" id="modal-skill-highlight" class="rounded bg-[#202020] border-[#343434] text-[#9CAF88]" />
          <label for="modal-skill-highlight" class="text-xs text-[#F5F5F5]">Highlight with accent dot</label>
        </div>

        <div class="flex items-center justify-end space-x-3 pt-3 border-t border-[#343434]/50">
          <button id="modal-cancel-btn" class="px-3 py-1.5 rounded-lg text-xs text-[#929292] hover:text-[#F5F5F5]">Cancel</button>
          <button id="modal-submit-btn" class="px-4 py-1.5 rounded-lg bg-[#9CAF88] text-[#1D1511] font-bold text-xs">Save Skill</button>
        </div>
      </div>
    </div>

  </div>

  <script>
    const modal = document.getElementById('skill-modal');
    const openModalBtn = document.getElementById('add-skill-modal-btn');
    const cancelModalBtn = document.getElementById('modal-cancel-btn');
    const submitModalBtn = document.getElementById('modal-submit-btn');

    openModalBtn?.addEventListener('click', () => modal?.classList.remove('hidden'));
    cancelModalBtn?.addEventListener('click', () => modal?.classList.add('hidden'));

    submitModalBtn?.addEventListener('click', async () => {
      const name = (document.getElementById('modal-skill-name') as HTMLInputElement).value;
      const description = (document.getElementById('modal-skill-desc') as HTMLInputElement).value;
      const category_id = (document.getElementById('modal-skill-cat') as HTMLSelectElement).value;
      const proficiency = (document.getElementById('modal-skill-prof') as HTMLSelectElement).value;
      const is_highlighted = (document.getElementById('modal-skill-highlight') as HTMLInputElement).checked;

      if (!name) return alert('Skill name required');

      const res = await fetch('/api/cms/skills', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, description, category_id, proficiency, is_highlighted }),
      });

      if (res.ok) window.location.reload();
      else alert('Failed to save skill');
    });

    document.querySelectorAll('[data-delete-skill]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-delete-skill');
        if (!confirm('Delete this skill?')) return;
        const res = await fetch(`/api/cms/skills?id=${id}`, { method: 'DELETE' });
        if (res.ok) window.location.reload();
      });
    });
  </script>

</AdminLayout>
