---
import { getAdminUserCount } from '../../lib/auth';
import '../../styles/global.css';

export const prerender = false;

// If an administrator already exists, redirect to login
try {
  const adminCount = await getAdminUserCount();
  if (adminCount > 0) {
    return Astro.redirect('/admin/login');
  }
} catch (err: any) {
  console.error('[Admin Setup Error] Database error on setup page load:', err);
  return Astro.redirect('/admin/login?error=db_error');
}
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Initial Setup — Create Administrator Account | Portfolio CMS</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style is:global>
      :root {
        --admin-bg: #111111;
        --admin-card: #202020;
        --admin-card-elevated: #282828;
        --admin-accent: #9CAF88;
        --admin-accent-hover: #B1C2A0;
        --admin-text-primary: #F5F5F5;
        --admin-text-secondary: #929292;
        --admin-border: #343434;
        --admin-success: #22C55E;
        --admin-error: #EF4444;
      }
      body {
        margin: 0;
        padding: 0;
        background-color: var(--admin-bg);
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        color: var(--admin-text-primary);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }
    </style>
  </head>
  <body class="bg-[#111111] text-[#F5F5F5] min-h-screen flex items-center justify-center p-4 sm:p-6 antialiased font-sans selection:bg-[#9CAF88] selection:text-black">
    
    <div class="w-full max-w-[480px] my-8">
      
      <!-- Fintrixity-Inspired Setup Card -->
      <div class="bg-[#202020] border border-[#343434] rounded-2xl p-6 sm:p-8 shadow-2xl relative overflow-hidden backdrop-blur-xl">
        
        <!-- Subtle Top Orange Ambient Light Accent -->
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[#9CAF88] to-transparent"></div>

        <!-- Header -->
        <div class="text-center mb-6">
          <div class="w-11 h-11 rounded-xl bg-[#9CAF88] text-[#1D1511] font-black font-mono text-base flex items-center justify-center mx-auto mb-3.5 shadow-lg shadow-[#9CAF88]/20">
            MB
          </div>
          <div class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold bg-[#9CAF88]/10 text-[#9CAF88] border border-[#9CAF88]/30 mb-2">
            INITIAL CONFIGURATION
          </div>
          <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-[#F5F5F5]">
            Create Administrator Account
          </h1>
          <p class="text-xs text-[#929292] mt-1 max-w-sm mx-auto leading-relaxed">
            Configure your root administrator credentials to manage your personal portfolio CMS.
          </p>
        </div>

        <!-- Dynamic Alert Container -->
        <div id="status-alert" class="hidden mb-5 p-3.5 rounded-xl border text-xs font-medium flex items-start space-x-2.5 transition-all">
          <span id="alert-icon" class="shrink-0 mt-0.5"></span>
          <span id="alert-message" class="leading-relaxed"></span>
        </div>

        <!-- Administrator Setup Form -->
        <form id="setup-form" class="space-y-4" novalidate>
          
          <!-- Field 1: Full Name -->
          <div>
            <label for="name" class="block text-xs font-semibold text-[#F5F5F5] mb-1.5 flex items-center justify-between">
              <span>Full Name <span class="text-[#9CAF88]">*</span></span>
              <span id="name-error" class="text-[11px] font-normal text-[#EF4444] hidden">Required</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-[#929292]">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </span>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                placeholder="Enter your full name"
                class="w-full bg-[#282828] border border-[#343434] rounded-lg pl-9 pr-3.5 py-2.5 text-xs sm:text-sm text-[#F5F5F5] placeholder-[#666666] focus:outline-none focus:border-[#9CAF88] focus:ring-1 focus:ring-[#9CAF88] transition-colors"
              />
            </div>
          </div>

          <!-- Field 2: Email Address -->
          <div>
            <label for="email" class="block text-xs font-semibold text-[#F5F5F5] mb-1.5 flex items-center justify-between">
              <span>Email Address <span class="text-[#9CAF88]">*</span></span>
              <span id="email-error" class="text-[11px] font-normal text-[#EF4444] hidden">Valid email required</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-[#929292]">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </span>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                placeholder="admin@example.com"
                class="w-full bg-[#282828] border border-[#343434] rounded-lg pl-9 pr-3.5 py-2.5 text-xs sm:text-sm text-[#F5F5F5] placeholder-[#666666] focus:outline-none focus:border-[#9CAF88] focus:ring-1 focus:ring-[#9CAF88] transition-colors"
              />
            </div>
          </div>

          <!-- Field 3: Password -->
          <div>
            <label for="password" class="block text-xs font-semibold text-[#F5F5F5] mb-1.5 flex items-center justify-between">
              <span>Password <span class="text-[#9CAF88]">*</span></span>
              <span id="password-strength-label" class="text-[11px] font-mono text-[#929292]">Min 12 chars</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-[#929292]">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </span>
              <input
                type="password"
                id="password"
                name="password"
                required
                minlength="12"
                autocomplete="new-password"
                placeholder="Enter password (minimum 12 characters)"
                class="w-full bg-[#282828] border border-[#343434] rounded-lg pl-9 pr-10 py-2.5 text-xs sm:text-sm text-[#F5F5F5] placeholder-[#666666] focus:outline-none focus:border-[#9CAF88] focus:ring-1 focus:ring-[#9CAF88] transition-colors"
              />
              <button
                type="button"
                id="toggle-password"
                aria-label="Toggle password visibility"
                class="absolute inset-y-0 right-0 pr-3 flex items-center text-[#929292] hover:text-[#F5F5F5] focus:outline-none"
              >
                <!-- Eye icon (default) -->
                <svg id="eye-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <!-- Eye off icon (hidden) -->
                <svg id="eye-off-icon" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                </svg>
              </button>
            </div>

            <!-- Password Strength Bar (4 Segments) -->
            <div class="mt-2 space-y-1.5">
              <div class="grid grid-cols-4 gap-1.5 h-1.5">
                <div id="bar-1" class="rounded-full bg-[#343434] transition-colors duration-200"></div>
                <div id="bar-2" class="rounded-full bg-[#343434] transition-colors duration-200"></div>
                <div id="bar-3" class="rounded-full bg-[#343434] transition-colors duration-200"></div>
                <div id="bar-4" class="rounded-full bg-[#343434] transition-colors duration-200"></div>
              </div>

              <!-- Password Requirements Checklist -->
              <div class="pt-1.5 grid grid-cols-2 gap-x-2 gap-y-1 text-[11px] font-mono text-[#929292]">
                <div id="req-len" class="flex items-center space-x-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#343434]"></span>
                  <span>12+ characters</span>
                </div>
                <div id="req-upper" class="flex items-center space-x-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#343434]"></span>
                  <span>Uppercase (A-Z)</span>
                </div>
                <div id="req-lower" class="flex items-center space-x-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#343434]"></span>
                  <span>Lowercase (a-z)</span>
                </div>
                <div id="req-sym" class="flex items-center space-x-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#343434]"></span>
                  <span>Number or symbol</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Field 4: Confirm Password -->
          <div>
            <label for="confirm-password" class="block text-xs font-semibold text-[#F5F5F5] mb-1.5 flex items-center justify-between">
              <span>Confirm Password <span class="text-[#9CAF88]">*</span></span>
              <span id="match-status" class="text-[11px] font-mono hidden"></span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-[#929292]">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </span>
              <input
                type="password"
                id="confirm-password"
                name="confirm-password"
                required
                autocomplete="new-password"
                placeholder="Re-enter your password"
                class="w-full bg-[#282828] border border-[#343434] rounded-lg pl-9 pr-10 py-2.5 text-xs sm:text-sm text-[#F5F5F5] placeholder-[#666666] focus:outline-none focus:border-[#9CAF88] focus:ring-1 focus:ring-[#9CAF88] transition-colors"
              />
              <button
                type="button"
                id="toggle-confirm-password"
                aria-label="Toggle confirm password visibility"
                class="absolute inset-y-0 right-0 pr-3 flex items-center text-[#929292] hover:text-[#F5F5F5] focus:outline-none"
              >
                <!-- Eye icon (default) -->
                <svg id="eye-icon-confirm" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <!-- Eye off icon (hidden) -->
                <svg id="eye-off-icon-confirm" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Full Width Orange Submit Button -->
          <div class="pt-2">
            <button
              type="submit"
              id="submit-btn"
              class="w-full py-3 px-4 bg-[#9CAF88] hover:bg-[#B1C2A0] active:bg-[#e04e18] text-black font-bold text-sm rounded-lg transition-all duration-200 shadow-lg shadow-[#9CAF88]/20 flex items-center justify-center space-x-2 focus:outline-none focus:ring-2 focus:ring-[#9CAF88] focus:ring-offset-2 focus:ring-offset-[#202020] disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <span id="btn-text">Create Administrator Account</span>
              <svg id="btn-arrow" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
              <svg id="btn-spinner" class="w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </div>

        </form>

        <!-- Security Note & Single-Admin Guarantee -->
        <div class="mt-6 pt-5 border-t border-[#343434] text-center space-y-1.5">
          <div class="flex items-center justify-center space-x-1.5 text-[11px] font-mono text-[#929292]">
            <svg class="w-3.5 h-3.5 text-[#22C55E]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>Argon2id Memory-Hard Cryptographic Hashing</span>
          </div>
          <p class="text-[10px] text-[#929292]/70 leading-relaxed font-mono">
            Initial setup is permitted only once. Public registration is locked immediately upon completion.
          </p>
        </div>

      </div>

    </div>

    <!-- Client-Side Form Validation, Password Strength & Submission Script -->
    <script>
      const form = document.getElementById('setup-form') as HTMLFormElement;
      const nameInput = document.getElementById('name') as HTMLInputElement;
      const emailInput = document.getElementById('email') as HTMLInputElement;
      const passwordInput = document.getElementById('password') as HTMLInputElement;
      const confirmInput = document.getElementById('confirm-password') as HTMLInputElement;

      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
      const btnText = document.getElementById('btn-text') as HTMLSpanElement;
      const btnArrow = document.getElementById('btn-arrow');
      const btnSpinner = document.getElementById('btn-spinner');

      const statusAlert = document.getElementById('status-alert') as HTMLDivElement;
      const alertIcon = document.getElementById('alert-icon') as HTMLSpanElement;
      const alertMessage = document.getElementById('alert-message') as HTMLSpanElement;

      const nameError = document.getElementById('name-error') as HTMLSpanElement;
      const emailError = document.getElementById('email-error') as HTMLSpanElement;
      const matchStatus = document.getElementById('match-status') as HTMLSpanElement;
      const strengthLabel = document.getElementById('password-strength-label') as HTMLSpanElement;

      // Strength Bars & Requirement Checkmarks
      const bar1 = document.getElementById('bar-1') as HTMLDivElement;
      const bar2 = document.getElementById('bar-2') as HTMLDivElement;
      const bar3 = document.getElementById('bar-3') as HTMLDivElement;
      const bar4 = document.getElementById('bar-4') as HTMLDivElement;

      const reqLen = document.getElementById('req-len') as HTMLDivElement;
      const reqUpper = document.getElementById('req-upper') as HTMLDivElement;
      const reqLower = document.getElementById('req-lower') as HTMLDivElement;
      const reqSym = document.getElementById('req-sym') as HTMLDivElement;

      // Visibility Toggles
      const togglePassword = document.getElementById('toggle-password');
      const eyeIcon = document.getElementById('eye-icon');
      const eyeOffIcon = document.getElementById('eye-off-icon');

      const toggleConfirmPassword = document.getElementById('toggle-confirm-password');
      const eyeIconConfirm = document.getElementById('eye-icon-confirm');
      const eyeOffIconConfirm = document.getElementById('eye-off-icon-confirm');

      const EMAIL_REGEX = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      // 1. Password Visibility Toggle
      togglePassword?.addEventListener('click', () => {
        const isPassword = passwordInput.type === 'password';
        passwordInput.type = isPassword ? 'text' : 'password';
        eyeIcon?.classList.toggle('hidden', isPassword);
        eyeOffIcon?.classList.toggle('hidden', !isPassword);
      });

      toggleConfirmPassword?.addEventListener('click', () => {
        const isPassword = confirmInput.type === 'password';
        confirmInput.type = isPassword ? 'text' : 'password';
        eyeIconConfirm?.classList.toggle('hidden', isPassword);
        eyeOffIconConfirm?.classList.toggle('hidden', !isPassword);
      });

      // 2. Alert Box Display
      function showAlert(msg: string, isSuccess = false) {
        statusAlert.classList.remove('hidden', 'bg-[#EF4444]/10', 'border-[#EF4444]/30', 'text-[#EF4444]', 'bg-[#22C55E]/10', 'border-[#22C55E]/30', 'text-[#22C55E]');
        if (isSuccess) {
          statusAlert.classList.add('bg-[#22C55E]/10', 'border-[#22C55E]/30', 'text-[#22C55E]');
          alertIcon.innerHTML = `<svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>`;
        } else {
          statusAlert.classList.add('bg-[#EF4444]/10', 'border-[#EF4444]/30', 'text-[#EF4444]');
          alertIcon.innerHTML = `<svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>`;
        }
        alertMessage.textContent = msg;
        statusAlert.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      function hideAlert() {
        statusAlert.classList.add('hidden');
      }

      // 3. Password Strength Evaluation
      function evaluatePassword() {
        const val = passwordInput.value;
        const hasLen = val.length >= 12;
        const hasUp = /[A-Z]/.test(val);
        const hasLow = /[a-z]/.test(val);
        const hasSym = /[\d!@#$%^&*()_+\-=[\]{};':"\\|,.<>/?`~]/.test(val);

        // Update Checklist Items
        updateChecklist(reqLen, hasLen);
        updateChecklist(reqUpper, hasUp);
        updateChecklist(reqLower, hasLow);
        updateChecklist(reqSym, hasSym);

        // Reset Bars
        [bar1, bar2, bar3, bar4].forEach((b) => {
          b.className = 'rounded-full bg-[#343434] transition-colors duration-200';
        });

        if (!val) {
          strengthLabel.textContent = 'Min 12 chars';
          strengthLabel.className = 'text-[11px] font-mono text-[#929292]';
          return 0;
        }

        let score = 0;
        if (hasLen) score++;
        if (hasUp && hasLow) score++;
        if (hasSym) score++;
        if (val.length >= 16 || (hasLen && hasUp && hasLow && hasSym && /[\d]/.test(val) && /[!@#$%^&*()_+\-=[\]{};':"\\|,.<>/?`~]/.test(val))) {
          score++;
        }

        if (score === 1) {
          bar1.className = 'rounded-full bg-[#EF4444] transition-colors duration-200';
          strengthLabel.textContent = 'Weak';
          strengthLabel.className = 'text-[11px] font-mono text-[#EF4444] font-semibold';
        } else if (score === 2) {
          bar1.className = 'rounded-full bg-[#F59E0B] transition-colors duration-200';
          bar2.className = 'rounded-full bg-[#F59E0B] transition-colors duration-200';
          strengthLabel.textContent = 'Fair';
          strengthLabel.className = 'text-[11px] font-mono text-[#F59E0B] font-semibold';
        } else if (score === 3) {
          bar1.className = 'rounded-full bg-[#3B82F6] transition-colors duration-200';
          bar2.className = 'rounded-full bg-[#3B82F6] transition-colors duration-200';
          bar3.className = 'rounded-full bg-[#3B82F6] transition-colors duration-200';
          strengthLabel.textContent = 'Good';
          strengthLabel.className = 'text-[11px] font-mono text-[#3B82F6] font-semibold';
        } else if (score >= 4) {
          bar1.className = 'rounded-full bg-[#22C55E] transition-colors duration-200';
          bar2.className = 'rounded-full bg-[#22C55E] transition-colors duration-200';
          bar3.className = 'rounded-full bg-[#22C55E] transition-colors duration-200';
          bar4.className = 'rounded-full bg-[#22C55E] transition-colors duration-200';
          strengthLabel.textContent = 'Strong';
          strengthLabel.className = 'text-[11px] font-mono text-[#22C55E] font-semibold';
        }

        return score;
      }

      function updateChecklist(el: HTMLDivElement, satisfied: boolean) {
        const dot = el.querySelector('span:first-child') as HTMLSpanElement;
        const text = el.querySelector('span:last-child') as HTMLSpanElement;
        if (satisfied) {
          dot.className = 'w-1.5 h-1.5 rounded-full bg-[#22C55E]';
          text.className = 'text-[#22C55E]';
        } else {
          dot.className = 'w-1.5 h-1.5 rounded-full bg-[#343434]';
          text.className = 'text-[#929292]';
        }
      }

      // 4. Confirm Password Matching Check
      function checkPasswordMatch(): boolean {
        const pwd = passwordInput.value;
        const confirmVal = confirmInput.value;

        if (!confirmVal) {
          matchStatus.classList.add('hidden');
          confirmInput.classList.remove('border-[#EF4444]', 'border-[#22C55E]');
          return false;
        }

        matchStatus.classList.remove('hidden');
        if (pwd === confirmVal) {
          matchStatus.textContent = 'Passwords match';
          matchStatus.className = 'text-[11px] font-mono text-[#22C55E]';
          confirmInput.classList.remove('border-[#EF4444]');
          confirmInput.classList.add('border-[#22C55E]');
          return true;
        } else {
          matchStatus.textContent = 'Passwords do not match';
          matchStatus.className = 'text-[11px] font-mono text-[#EF4444]';
          confirmInput.classList.remove('border-[#22C55E]');
          confirmInput.classList.add('border-[#EF4444]');
          return false;
        }
      }

      // Live event listeners
      passwordInput.addEventListener('input', () => {
        evaluatePassword();
        if (confirmInput.value) checkPasswordMatch();
      });

      confirmInput.addEventListener('input', checkPasswordMatch);

      nameInput.addEventListener('input', () => {
        if (nameInput.value.trim().length >= 2) nameError.classList.add('hidden');
      });

      emailInput.addEventListener('input', () => {
        if (EMAIL_REGEX.test(emailInput.value.trim())) emailError.classList.add('hidden');
      });

      // 5. Form Submission Handler
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideAlert();

        const name = nameInput.value.trim();
        const email = emailInput.value.trim();
        const password = passwordInput.value;
        const confirmPassword = confirmInput.value;

        let hasError = false;

        // Validate Full Name
        if (!name || name.length < 2) {
          nameError.textContent = 'Full name is required';
          nameError.classList.remove('hidden');
          nameInput.focus();
          hasError = true;
        } else {
          nameError.classList.add('hidden');
        }

        // Validate Email
        if (!email || !EMAIL_REGEX.test(email)) {
          emailError.textContent = 'Valid email is required';
          emailError.classList.remove('hidden');
          if (!hasError) emailInput.focus();
          hasError = true;
        } else {
          emailError.classList.add('hidden');
        }

        // Validate Password
        if (password.length < 12) {
          showAlert('Password must be at least 12 characters long.');
          if (!hasError) passwordInput.focus();
          return;
        }

        const hasUp = /[A-Z]/.test(password);
        const hasLow = /[a-z]/.test(password);
        const hasSym = /[\d!@#$%^&*()_+\-=[\]{};':"\\|,.<>/?`~]/.test(password);

        if (!hasUp || !hasLow || !hasSym) {
          showAlert('Password must include uppercase, lowercase, and at least one number or symbol.');
          if (!hasError) passwordInput.focus();
          return;
        }

        // Validate Confirmation
        if (password !== confirmPassword) {
          matchStatus.textContent = 'Passwords do not match';
          matchStatus.className = 'text-[11px] font-mono text-[#EF4444]';
          matchStatus.classList.remove('hidden');
          showAlert('Confirm password does not match the password.');
          confirmInput.focus();
          return;
        }

        if (hasError) return;

        // Submission state
        submitBtn.disabled = true;
        btnText.textContent = 'Initializing Administrator Account...';
        btnArrow?.classList.add('hidden');
        btnSpinner?.classList.remove('hidden');

        try {
          const res = await fetch('/api/auth/setup', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name,
              email,
              password,
              confirmPassword,
            }),
          });

          const data = await res.json().catch(() => ({}));

          if (res.ok && data.success) {
            showAlert('Administrator account created successfully! Launching dashboard...', true);
            btnText.textContent = 'Redirecting to Dashboard...';
            setTimeout(() => {
              window.location.href = data.redirect || '/admin';
            }, 600);
          } else {
            showAlert(data.error || 'Failed to initialize administrator account.');
            resetButton();
          }
        } catch (err: any) {
          showAlert('Network or server error occurred. Please try again.');
          resetButton();
        }
      });

      function resetButton() {
        submitBtn.disabled = false;
        btnText.textContent = 'Create Administrator Account';
        btnArrow?.classList.remove('hidden');
        btnSpinner?.classList.add('hidden');
      }
    </script>
  </body>
</html>