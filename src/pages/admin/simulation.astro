---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getModuleConfig } from '../../lib/content';

export const prerender = false;

const simConfig = (await getModuleConfig('simulation')) || {
  title: 'SIMULATION HARNESS // LIVE ORCHESTRATION',
  subtitle: 'INTERACTIVE RUNNER TELEMETRY',
  description: 'Interactive execution harness demonstrating Docker container lifecycle, task queue buffering, and exit code verification.',
  defaultTimeout: 5000,
  memoryCap: '128MB',
  cpuCeiling: '0.5 Cores'
};
---

<AdminLayout title="Simulation Harness Config" subtitle="Manage sandbox parameters, limits & presentation labels" activeNav="simulation">
  
  <div class="max-w-3xl space-y-6">
    <div class="bg-[#202020] border border-[#343434] rounded-xl p-5 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-base font-bold text-[#F5F5F5]">Simulation Harness Presentation</h2>
        <p class="text-xs text-[#929292] mt-1">Configure telemetry headlines, container isolation limits, and simulation defaults for MicroBounty.</p>
      </div>
      <a href="/#systems" target="_blank" class="px-3 py-1.5 rounded-lg bg-[#282828] hover:bg-[#343434] text-xs text-[#F5F5F5] border border-[#343434] transition-colors self-start md:self-auto flex items-center space-x-1.5">
        <span>View on Site</span>
        <svg class="w-3.5 h-3.5 text-[#9CAF88]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </div>

    <!-- Alert / Toast Banner -->
    <div id="status-toast" class="hidden p-4 rounded-xl border text-xs font-mono transition-all"></div>

    <form id="sim-form" class="bg-[#202020] border border-[#343434] rounded-xl p-6 space-y-5 text-xs">
      
      <div>
        <label class="block text-[#929292] font-mono text-[11px] mb-1.5">MODULE TITLE *</label>
        <input
          type="text"
          id="sim-title"
          required
          value={simConfig.title}
          class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3.5 py-2.5 text-[#F5F5F5] font-mono focus:border-[#9CAF88] focus:outline-none"
        />
      </div>

      <div>
        <label class="block text-[#929292] font-mono text-[11px] mb-1.5">SUBTITLE / TELEMETRY BADGE</label>
        <input
          type="text"
          id="sim-subtitle"
          value={simConfig.subtitle}
          class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3.5 py-2.5 text-[#F5F5F5] font-mono focus:border-[#9CAF88] focus:outline-none"
        />
      </div>

      <div>
        <label class="block text-[#929292] font-mono text-[11px] mb-1.5">DESCRIPTION / OVERVIEW</label>
        <textarea
          id="sim-desc"
          rows="3"
          class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3.5 py-2.5 text-[#F5F5F5] leading-relaxed focus:border-[#9CAF88] focus:outline-none"
        >{simConfig.description}</textarea>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
        <div>
          <label class="block text-[#929292] font-mono text-[11px] mb-1.5">DEFAULT TIMEOUT (MS)</label>
          <input
            type="number"
            id="sim-timeout"
            value={simConfig.defaultTimeout || 5000}
            class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3.5 py-2.5 text-[#F5F5F5] font-mono focus:border-[#9CAF88] focus:outline-none"
          />
        </div>
        <div>
          <label class="block text-[#929292] font-mono text-[11px] mb-1.5">SANDBOX MEMORY CAP</label>
          <input
            type="text"
            id="sim-memory"
            value={simConfig.memoryCap || '128MB'}
            class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3.5 py-2.5 text-[#F5F5F5] font-mono focus:border-[#9CAF88] focus:outline-none"
          />
        </div>
        <div>
          <label class="block text-[#929292] font-mono text-[11px] mb-1.5">CPU ALLOCATION</label>
          <input
            type="text"
            id="sim-cpu"
            value={simConfig.cpuCeiling || '0.5 Cores'}
            class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3.5 py-2.5 text-[#F5F5F5] font-mono focus:border-[#9CAF88] focus:outline-none"
          />
        </div>
      </div>

      <div class="pt-4 border-t border-[#343434] flex items-center justify-end">
        <button
          type="submit"
          id="save-btn"
          class="px-5 py-2.5 rounded-lg bg-[#9CAF88] hover:bg-[#B1C2A0] text-[#1D1511] font-bold text-xs transition-colors shadow-sm"
        >
          Save Simulation Settings
        </button>
      </div>

    </form>
  </div>

  <script>
    const form = document.getElementById('sim-form');
    const toast = document.getElementById('status-toast');

    function showToast(msg: string, isError = false) {
      if (!toast) return;
      toast.classList.remove('hidden', 'bg-[#22C55E]/10', 'text-[#22C55E]', 'border-[#22C55E]/30', 'bg-[#EF4444]/10', 'text-[#EF4444]', 'border-[#EF4444]/30');
      if (isError) {
        toast.classList.add('bg-[#EF4444]/10', 'text-[#EF4444]', 'border-[#EF4444]/30');
      } else {
        toast.classList.add('bg-[#22C55E]/10', 'text-[#22C55E]', 'border-[#22C55E]/30');
      }
      toast.textContent = msg;
      setTimeout(() => toast?.classList.add('hidden'), 4000);
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const title = (document.getElementById('sim-title') as HTMLInputElement).value;
      const subtitle = (document.getElementById('sim-subtitle') as HTMLInputElement).value;
      const description = (document.getElementById('sim-desc') as HTMLTextAreaElement).value;
      const defaultTimeout = parseInt((document.getElementById('sim-timeout') as HTMLInputElement).value, 10);
      const memoryCap = (document.getElementById('sim-memory') as HTMLInputElement).value;
      const cpuCeiling = (document.getElementById('sim-cpu') as HTMLInputElement).value;

      try {
        const res = await fetch('/api/cms/modules', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            key: 'simulation',
            data: { title, subtitle, description, defaultTimeout, memoryCap, cpuCeiling }
          }),
        });
        const json = await res.json();
        if (res.ok) {
          showToast('Simulation settings updated successfully!');
        } else {
          showToast(json.error || 'Failed to save', true);
        }
      } catch (err: any) {
        showToast(err.message, true);
      }
    });
  </script>
</AdminLayout>