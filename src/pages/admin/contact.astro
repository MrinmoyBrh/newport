---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getModuleConfig } from '../../lib/content';

export const prerender = false;

const contactConfig = (await getModuleConfig('contact')) || {
  heading: 'Coordinates.',
  subheading: 'Initiate Secure Transmission',
  tagline: 'Always open to discussing resilient backend architectures, API engineering, databases, and practical distributed computing problems.',
  email: 'mrinmoyborah360@gmail.com',
  githubUrl: 'https://github.com/MrinmoyBrh',
  linkedinUrl: 'https://www.linkedin.com/in/mrinmoy-borah-7771843b9/',
  location: 'Assam, India',
  status: 'Open to Software Engineering Opportunities'
};
---

<AdminLayout title="Contact Coordinates" subtitle="Manage transmission points, channels & availability status" activeNav="contact">
  
  <div class="max-w-3xl space-y-6">
    <div class="bg-[#202020] border border-[#343434] rounded-xl p-5 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-base font-bold text-[#F5F5F5]">Contact Ingress Points</h2>
        <p class="text-xs text-[#929292] mt-1">Configure your email address, geographic coordinates, social channels, and current work status.</p>
      </div>
      <a href="/#contact" target="_blank" class="px-3 py-1.5 rounded-lg bg-[#282828] hover:bg-[#343434] text-xs text-[#F5F5F5] border border-[#343434] transition-colors self-start md:self-auto flex items-center space-x-1.5">
        <span>View on Site</span>
        <svg class="w-3.5 h-3.5 text-[#9CAF88]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </div>

    <!-- Alert / Toast Banner -->
    <div id="status-toast" class="hidden p-4 rounded-xl border text-xs font-mono transition-all"></div>

    <form id="contact-form" class="bg-[#202020] border border-[#343434] rounded-xl p-6 space-y-5 text-xs">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-[#929292] font-mono text-[11px] mb-1.5">MAIN HEADING *</label>
          <input
            type="text"
            id="c-heading"
            required
            value={contactConfig.heading || 'Coordinates.'}
            class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3.5 py-2.5 text-[#F5F5F5] focus:border-[#9CAF88] focus:outline-none"
          />
        </div>
        <div>
          <label class="block text-[#929292] font-mono text-[11px] mb-1.5">SUBHEADING / EYEBROW *</label>
          <input
            type="text"
            id="c-subheading"
            required
            value={contactConfig.subheading || 'Initiate Secure Transmission'}
            class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3.5 py-2.5 text-[#F5F5F5] font-mono focus:border-[#9CAF88] focus:outline-none"
          />
        </div>
      </div>

      <div>
        <label class="block text-[#929292] font-mono text-[11px] mb-1.5">TAGLINE / INTRO NARRATIVE</label>
        <textarea
          id="c-tagline"
          rows="3"
          class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3.5 py-2.5 text-[#F5F5F5] leading-relaxed focus:border-[#9CAF88] focus:outline-none"
        >{contactConfig.tagline}</textarea>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-[#929292] font-mono text-[11px] mb-1.5">PRIMARY EMAIL ADDRESS *</label>
          <input
            type="email"
            id="c-email"
            required
            value={contactConfig.email || ''}
            class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3.5 py-2.5 text-[#F5F5F5] font-mono focus:border-[#9CAF88] focus:outline-none"
          />
        </div>
        <div>
          <label class="block text-[#929292] font-mono text-[11px] mb-1.5">AVAILABILITY STATUS</label>
          <input
            type="text"
            id="c-status"
            value={contactConfig.status || 'Open to Software Engineering Opportunities'}
            class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3.5 py-2.5 text-[#22C55E] focus:border-[#9CAF88] focus:outline-none"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-[#929292] font-mono text-[11px] mb-1.5">GEOGRAPHIC LOCATION</label>
          <input
            type="text"
            id="c-location"
            value={contactConfig.location || 'Assam, India'}
            class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3.5 py-2.5 text-[#F5F5F5] focus:border-[#9CAF88] focus:outline-none"
          />
        </div>
        <div>
          <label class="block text-[#929292] font-mono text-[11px] mb-1.5">GITHUB PROFILE URL</label>
          <input
            type="url"
            id="c-github"
            value={contactConfig.githubUrl || ''}
            class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3.5 py-2.5 text-[#F5F5F5] font-mono focus:border-[#9CAF88] focus:outline-none"
          />
        </div>
      </div>

      <div>
        <label class="block text-[#929292] font-mono text-[11px] mb-1.5">LINKEDIN PROFILE URL</label>
        <input
          type="url"
          id="c-linkedin"
          value={contactConfig.linkedinUrl || ''}
          class="w-full bg-[#191919] border border-[#343434] rounded-lg px-3.5 py-2.5 text-[#F5F5F5] font-mono focus:border-[#9CAF88] focus:outline-none"
        />
      </div>

      <div class="pt-4 border-t border-[#343434] flex items-center justify-end">
        <button
          type="submit"
          class="px-5 py-2.5 rounded-lg bg-[#9CAF88] hover:bg-[#B1C2A0] text-[#1D1511] font-bold text-xs transition-colors shadow-sm"
        >
          Save Contact Coordinates
        </button>
      </div>

    </form>
  </div>

  <script>
    const form = document.getElementById('contact-form');
    const toast = document.getElementById('status-toast');

    function showToast(msg: string, isError = false) {
      if (!toast) return;
      toast.classList.remove('hidden', 'bg-[#22C55E]/10', 'text-[#22C55E]', 'border-[#22C55E]/30', 'bg-[#EF4444]/10', 'text-[#EF4444]', 'border-[#EF4444]/30');
      if (isError) {
        toast.classList.add('bg-[#EF4444]/10', 'text-[#EF4444]', 'border-[#EF4444]/30');
      } else {
        toast.classList.add('bg-[#22C55E]/10', 'text-[#22C55E]', 'border-[#22C55E]/30');
      }
      toast.textContent = msg;
      setTimeout(() => toast?.classList.add('hidden'), 4000);
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const heading = (document.getElementById('c-heading') as HTMLInputElement).value;
      const subheading = (document.getElementById('c-subheading') as HTMLInputElement).value;
      const tagline = (document.getElementById('c-tagline') as HTMLTextAreaElement).value;
      const email = (document.getElementById('c-email') as HTMLInputElement).value;
      const status = (document.getElementById('c-status') as HTMLInputElement).value;
      const location = (document.getElementById('c-location') as HTMLInputElement).value;
      const githubUrl = (document.getElementById('c-github') as HTMLInputElement).value;
      const linkedinUrl = (document.getElementById('c-linkedin') as HTMLInputElement).value;

      try {
        const res = await fetch('/api/cms/modules', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            key: 'contact',
            data: { heading, subheading, tagline, email, status, location, githubUrl, linkedinUrl }
          }),
        });
        const json = await res.json();
        if (res.ok) {
          showToast('Contact coordinates updated successfully!');
        } else {
          showToast(json.error || 'Failed to save', true);
        }
      } catch (err: any) {
        showToast(err.message, true);
      }
    });
  </script>
</AdminLayout>