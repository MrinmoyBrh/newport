---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAppearanceSettings } from '../../lib/content';

export const prerender = false;

const appearance = await getAppearanceSettings(false);
const clouds = appearance.cloudAnimation || {
  enabled: true,
  opacity: 0.16,
  blurPx: 120,
  speedMultiplier: 0.8,
  cloud1Color: '#9CAF88',
  cloud2Color: '#403027',
  cloud3Color: '#2B1D16'
};
---

<AdminLayout title="Appearance & Atmospheric Clouds" subtitle="Manage theme tokens & organic background cloud animation" activeNav="appearance">
  
  <div class="space-y-6 max-w-4xl">
    <!-- Header Banner -->
    <div class="bg-[#202020] border border-[#343434] rounded-xl p-5 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-base font-bold text-[#F5F5F5]">Public Portfolio Visual Identity</h2>
        <p class="text-xs text-[#929292] mt-1">Fine-tune the slow-drifting atmospheric RGB cloud gradient behind portfolio sections.</p>
      </div>
      <div class="flex items-center space-x-2">
        <a href="/admin/preview" target="_blank" class="px-3 py-1.5 rounded-lg bg-[#282828] hover:bg-[#343434] text-xs text-[#F5F5F5] border border-[#343434] transition-colors flex items-center space-x-1.5">
          <span>Test in Preview</span>
          <svg class="w-3.5 h-3.5 text-[#9CAF88]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
        </a>
      </div>
    </div>

    <!-- Alert / Toast Banner -->
    <div id="status-toast" class="hidden p-4 rounded-xl border text-xs font-mono transition-all"></div>

    <!-- Strict Brand Color Swatches -->
    <div class="bg-[#2B1D16]/80 border border-[#E9DFCF]/15 rounded-xl p-6">
      <h3 class="text-xs font-mono uppercase tracking-wider text-[#C9BFAF] font-semibold mb-3">Portfolio V2 Color Palette</h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
        <div class="bg-[#1D1511] border border-[#E9DFCF]/10 rounded-lg p-3">
          <div class="w-full h-8 rounded bg-[#1D1511] border border-[#E9DFCF]/20 mb-2"></div>
          <div class="font-bold text-[#E9DFCF]">Deep Espresso</div>
          <div class="text-[11px] font-mono text-[#C9BFAF]">#1D1511</div>
        </div>
        <div class="bg-[#1D1511] border border-[#E9DFCF]/10 rounded-lg p-3">
          <div class="w-full h-8 rounded bg-[#2B1D16] border border-[#E9DFCF]/20 mb-2"></div>
          <div class="font-bold text-[#E9DFCF]">Espresso</div>
          <div class="text-[11px] font-mono text-[#C9BFAF]">#2B1D16</div>
        </div>
        <div class="bg-[#1D1511] border border-[#E9DFCF]/10 rounded-lg p-3">
          <div class="w-full h-8 rounded bg-[#E9DFCF] mb-2"></div>
          <div class="font-bold text-[#1D1511]">Oat</div>
          <div class="text-[11px] font-mono text-[#C9BFAF]">#E9DFCF</div>
        </div>
        <div class="bg-[#1D1511] border border-[#E9DFCF]/10 rounded-lg p-3">
          <div class="w-full h-8 rounded bg-[#9CAF88] mb-2"></div>
          <div class="font-bold text-[#1D1511]">Sage Green</div>
          <div class="text-[11px] font-mono text-[#C9BFAF]">#9CAF88</div>
        </div>
      </div>
    </div>

    <!-- Atmospheric Clouds Configuration -->
    <form id="appearance-form" class="bg-[#2B1D16]/70 border border-[#E9DFCF]/15 rounded-xl p-6 space-y-6 text-xs">
      
      <div class="flex items-center justify-between pb-4 border-b border-[#E9DFCF]/10">
        <div>
          <h3 class="text-sm font-bold text-[#E9DFCF]">Dynamic Atmospheric Cloud Background</h3>
          <p class="text-xs text-[#C9BFAF] mt-0.5">Enables organic, slowly shifting blurred gradients beneath sections below the hero.</p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" id="cloud-enabled" class="sr-only peer" checked={clouds.enabled} />
          <div class="w-11 h-6 bg-[#1D1511] peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#9CAF88]"></div>
        </label>
      </div>

      <!-- Cloud Simulation Live Canvas Preview -->
      <div class="relative h-44 rounded-xl overflow-hidden bg-[#1D1511] border border-[#E9DFCF]/15 flex items-center justify-center p-4">
        <div
          id="preview-cloud-1"
          class="absolute w-48 h-48 rounded-full pointer-events-none transition-all duration-700"
          style={`background: radial-gradient(circle, ${clouds.cloud1Color || '#9CAF88'} 0%, transparent 70%); opacity: ${clouds.opacity || 0.16}; filter: blur(${clouds.blurPx || 120}px); top: 10%; left: 20%;`}
        ></div>
        <div
          id="preview-cloud-2"
          class="absolute w-56 h-56 rounded-full pointer-events-none transition-all duration-700"
          style={`background: radial-gradient(circle, ${clouds.cloud2Color || '#403027'} 0%, transparent 70%); opacity: ${clouds.opacity || 0.16}; filter: blur(${clouds.blurPx || 120}px); bottom: 10%; right: 20%;`}
        ></div>

        <div class="relative z-10 text-center space-y-1">
          <span class="px-2.5 py-1 rounded bg-black/60 border border-white/10 text-white font-mono text-[11px] backdrop-blur-md">
            ATMOSPHERIC CANVAS TELEMETRY
          </span>
          <p class="text-[11px] text-[#C9BFAF]">Real-time preview reflects opacity & blur settings below.</p>
        </div>
      </div>

      <!-- Parameter Sliders -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
        <div>
          <div class="flex items-center justify-between text-[#929292] font-mono text-[11px] mb-2">
            <span>OPACITY</span>
            <span id="opacity-val" class="text-[#9CAF88] font-bold">{clouds.opacity || 0.14}</span>
          </div>
          <input
            type="range"
            id="cloud-opacity"
            min="0.04"
            max="0.35"
            step="0.01"
            value={clouds.opacity || 0.14}
            class="w-full accent-[#9CAF88] bg-[#282828] rounded-lg cursor-pointer"
          />
        </div>

        <div>
          <div class="flex items-center justify-between text-[#929292] font-mono text-[11px] mb-2">
            <span>DIFFUSION BLUR (PX)</span>
            <span id="blur-val" class="text-[#9CAF88] font-bold">{clouds.blurPx || 120}px</span>
          </div>
          <input
            type="range"
            id="cloud-blur"
            min="60"
            max="180"
            step="5"
            value={clouds.blurPx || 120}
            class="w-full accent-[#9CAF88] bg-[#282828] rounded-lg cursor-pointer"
          />
        </div>

        <div>
          <div class="flex items-center justify-between text-[#929292] font-mono text-[11px] mb-2">
            <span>DRIFT SPEED</span>
            <span id="speed-val" class="text-[#9CAF88] font-bold">{clouds.speedMultiplier || 1.0}x</span>
          </div>
          <input
            type="range"
            id="cloud-speed"
            min="0.4"
            max="2.5"
            step="0.1"
            value={clouds.speedMultiplier || 1.0}
            class="w-full accent-[#9CAF88] bg-[#282828] rounded-lg cursor-pointer"
          />
        </div>
      </div>

      <!-- Cloud Colors -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4 border-t border-[#E9DFCF]/10">
        <div>
          <label class="block text-[#C9BFAF] font-mono text-[11px] mb-1.5">PRIMARY SAGE CLOUD</label>
          <div class="flex items-center space-x-2">
            <input type="color" id="cloud1-picker" value={clouds.cloud1Color || '#9CAF88'} class="w-8 h-8 rounded bg-transparent border-0 cursor-pointer" />
            <input type="text" id="cloud1-hex" value={clouds.cloud1Color || '#9CAF88'} class="flex-1 bg-[#1D1511] border border-[#E9DFCF]/15 rounded-lg px-2.5 py-1.5 text-xs text-[#E9DFCF] font-mono" />
          </div>
        </div>

        <div>
          <label class="block text-[#C9BFAF] font-mono text-[11px] mb-1.5">SECONDARY WARM BROWN CLOUD</label>
          <div class="flex items-center space-x-2">
            <input type="color" id="cloud2-picker" value={clouds.cloud2Color || '#403027'} class="w-8 h-8 rounded bg-transparent border-0 cursor-pointer" />
            <input type="text" id="cloud2-hex" value={clouds.cloud2Color || '#403027'} class="flex-1 bg-[#1D1511] border border-[#E9DFCF]/15 rounded-lg px-2.5 py-1.5 text-xs text-[#E9DFCF] font-mono" />
          </div>
        </div>

        <div>
          <label class="block text-[#C9BFAF] font-mono text-[11px] mb-1.5">TERTIARY ESPRESSO CLOUD</label>
          <div class="flex items-center space-x-2">
            <input type="color" id="cloud3-picker" value={clouds.cloud3Color || '#2B1D16'} class="w-8 h-8 rounded bg-transparent border-0 cursor-pointer" />
            <input type="text" id="cloud3-hex" value={clouds.cloud3Color || '#2B1D16'} class="flex-1 bg-[#1D1511] border border-[#E9DFCF]/15 rounded-lg px-2.5 py-1.5 text-xs text-[#E9DFCF] font-mono" />
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="pt-4 border-t border-[#343434] flex items-center justify-end space-x-3">
        <button
          type="button"
          id="save-draft-btn"
          class="px-4 py-2 rounded-lg bg-[#282828] hover:bg-[#343434] text-xs text-[#F5F5F5] border border-[#343434] transition-colors"
        >
          Save Draft
        </button>
        <button
          type="button"
          id="publish-btn"
          class="px-5 py-2 rounded-lg bg-[#9CAF88] hover:bg-[#B1C2A0] text-[#1D1511] font-bold text-xs transition-colors shadow-sm"
        >
          Publish Appearance
        </button>
      </div>

    </form>
  </div>

  <script>
    const toast = document.getElementById('status-toast');
    const saveDraftBtn = document.getElementById('save-draft-btn');
    const publishBtn = document.getElementById('publish-btn');

    const enabledToggle = document.getElementById('cloud-enabled') as HTMLInputElement;
    const opacitySlider = document.getElementById('cloud-opacity') as HTMLInputElement;
    const opacityVal = document.getElementById('opacity-val');
    const blurSlider = document.getElementById('cloud-blur') as HTMLInputElement;
    const blurVal = document.getElementById('blur-val');
    const speedSlider = document.getElementById('cloud-speed') as HTMLInputElement;
    const speedVal = document.getElementById('speed-val');

    const cloud1Picker = document.getElementById('cloud1-picker') as HTMLInputElement;
    const cloud1Hex = document.getElementById('cloud1-hex') as HTMLInputElement;
    const cloud2Picker = document.getElementById('cloud2-picker') as HTMLInputElement;
    const cloud2Hex = document.getElementById('cloud2-hex') as HTMLInputElement;
    const cloud3Picker = document.getElementById('cloud3-picker') as HTMLInputElement;
    const cloud3Hex = document.getElementById('cloud3-hex') as HTMLInputElement;

    const previewCloud1 = document.getElementById('preview-cloud-1');
    const previewCloud2 = document.getElementById('preview-cloud-2');

    function updatePreview() {
      const op = opacitySlider.value;
      const bl = blurSlider.value;
      const c1 = cloud1Hex.value;
      const c2 = cloud2Hex.value;

      if (opacityVal) opacityVal.textContent = op;
      if (blurVal) blurVal.textContent = `${bl}px`;
      if (speedVal) speedVal.textContent = `${speedSlider.value}x`;

      if (previewCloud1) {
        previewCloud1.style.background = `radial-gradient(circle, ${c1} 0%, transparent 70%)`;
        previewCloud1.style.opacity = op;
        previewCloud1.style.filter = `blur(${bl}px)`;
      }
      if (previewCloud2) {
        previewCloud2.style.background = `radial-gradient(circle, ${c2} 0%, transparent 70%)`;
        previewCloud2.style.opacity = op;
        previewCloud2.style.filter = `blur(${bl}px)`;
      }
    }

    opacitySlider?.addEventListener('input', updatePreview);
    blurSlider?.addEventListener('input', updatePreview);
    speedSlider?.addEventListener('input', updatePreview);

    cloud1Picker?.addEventListener('input', () => {
      cloud1Hex.value = cloud1Picker.value;
      updatePreview();
    });
    cloud1Hex?.addEventListener('input', () => {
      cloud1Picker.value = cloud1Hex.value;
      updatePreview();
    });

    cloud2Picker?.addEventListener('input', () => {
      cloud2Hex.value = cloud2Picker.value;
      updatePreview();
    });
    cloud2Hex?.addEventListener('input', () => {
      cloud2Picker.value = cloud2Hex.value;
      updatePreview();
    });

    cloud3Picker?.addEventListener('input', () => {
      cloud3Hex.value = cloud3Picker.value;
    });
    cloud3Hex?.addEventListener('input', () => {
      cloud3Picker.value = cloud3Hex.value;
    });

    function showToast(msg: string, isError = false) {
      if (!toast) return;
      toast.classList.remove('hidden', 'bg-[#22C55E]/10', 'text-[#22C55E]', 'border-[#22C55E]/30', 'bg-[#EF4444]/10', 'text-[#EF4444]', 'border-[#EF4444]/30');
      if (isError) {
        toast.classList.add('bg-[#EF4444]/10', 'text-[#EF4444]', 'border-[#EF4444]/30');
      } else {
        toast.classList.add('bg-[#22C55E]/10', 'text-[#22C55E]', 'border-[#22C55E]/30');
      }
      toast.textContent = msg;
      setTimeout(() => toast?.classList.add('hidden'), 4000);
    }

    function getAppearancePayload() {
      return {
        deepEspresso: '#1D1511',
        espresso: '#2B1D16',
        warmBrown: '#403027',
        oat: '#E9DFCF',
        mutedOat: '#C9BFAF',
        sageGreen: '#9CAF88',
        cloudAnimation: {
          enabled: enabledToggle.checked,
          opacity: parseFloat(opacitySlider.value),
          blurPx: parseInt(blurSlider.value, 10),
          speedMultiplier: parseFloat(speedSlider.value),
          cloud1Color: cloud1Hex.value,
          cloud2Color: cloud2Hex.value,
          cloud3Color: cloud3Hex.value,
        }
      };
    }

    saveDraftBtn?.addEventListener('click', async () => {
      const payload = getAppearancePayload();
      try {
        const res = await fetch('/api/cms/appearance', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'draft', data: payload }),
        });
        const json = await res.json();
        if (res.ok) {
          showToast('Appearance settings saved to draft!');
        } else {
          showToast(json.error || 'Failed to save draft', true);
        }
      } catch (err: any) {
        showToast(err.message, true);
      }
    });

    publishBtn?.addEventListener('click', async () => {
      const payload = getAppearancePayload();
      try {
        const res = await fetch('/api/cms/appearance', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'publish', data: payload }),
        });
        const json = await res.json();
        if (res.ok) {
          showToast('Appearance published live to public site!');
        } else {
          showToast(json.error || 'Failed to publish', true);
        }
      } catch (err: any) {
        showToast(err.message, true);
      }
    });
  </script>
</AdminLayout>