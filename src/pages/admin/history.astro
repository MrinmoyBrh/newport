---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getRevisions } from '../../lib/content';
import { getDb } from '../../lib/db';

export const prerender = false;

const revisions = await getRevisions(undefined, 50);

const db = getDb();
const logs = (await db.prepare('SELECT * FROM activity_logs ORDER BY created_at DESC LIMIT 50').all()) as any[];
---

<AdminLayout title="Revisions & Audit History" subtitle="Trace operational events, audit trail & one-click snapshot rollback" activeNav="history">
  
  <div class="space-y-6">
    <!-- Header Banner -->
    <div class="bg-[#202020] border border-[#343434] rounded-xl p-5 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-base font-bold text-[#F5F5F5] flex items-center space-x-2">
          <span>Release Snapshots & Audit Trail</span>
          <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-[#9CAF88]/10 text-[#9CAF88] border border-[#9CAF88]/30">{revisions.length} Snapshots</span>
        </h2>
        <p class="text-xs text-[#929292] mt-1">Every published change automatically generates an immutable point-in-time snapshot with rollback capabilities.</p>
      </div>
    </div>

    <!-- Alert / Toast Banner -->
    <div id="status-toast" class="hidden p-4 rounded-xl border text-xs font-mono transition-all"></div>

    <!-- Two Column: Revisions (Rollback) & Activity Logs -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      
      <!-- Column 1: Revisions (Rollbacks) -->
      <div class="bg-[#202020] border border-[#343434] rounded-xl p-6 flex flex-col">
        <h3 class="text-xs font-mono uppercase tracking-wider text-[#929292] font-semibold mb-4 flex items-center space-x-2">
          <svg class="w-4 h-4 text-[#9CAF88]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>Historical Release Snapshots</span>
        </h3>

        {revisions.length === 0 ? (
          <div class="p-8 text-center text-xs text-[#929292] bg-[#191919] rounded-lg border border-[#343434]">
            No revisions generated yet. Revisions are created automatically whenever you publish changes.
          </div>
        ) : (
          <div class="space-y-3 overflow-y-auto max-h-[600px] custom-scrollbar pr-1">
            {revisions.map((rev: any) => (
              <div class="p-3.5 bg-[#191919] border border-[#343434] rounded-lg hover:border-[#444444] transition-colors text-xs flex flex-col justify-between space-y-2">
                <div class="flex items-start justify-between gap-2">
                  <div>
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-[#282828] text-[#9CAF88] border border-[#343434] uppercase font-bold">
                      {rev.entity_type}
                    </span>
                    <span class="text-xs font-semibold text-[#F5F5F5] block mt-1">{rev.summary}</span>
                  </div>
                  <button
                    class="rollback-btn px-2.5 py-1 rounded bg-[#282828] hover:bg-[#9CAF88] hover:text-black text-[11px] text-[#F5F5F5] font-mono border border-[#343434] transition-colors whitespace-nowrap"
                    data-id={rev.id}
                  >
                    Restore
                  </button>
                </div>
                <div class="text-[10px] text-[#929292] font-mono flex items-center justify-between border-t border-[#343434]/40 pt-1.5">
                  <span>Target: {rev.entity_id}</span>
                  <span>{new Date(rev.published_at).toLocaleString()}</span>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Column 2: Audit Logs -->
      <div class="bg-[#202020] border border-[#343434] rounded-xl p-6 flex flex-col">
        <h3 class="text-xs font-mono uppercase tracking-wider text-[#929292] font-semibold mb-4 flex items-center space-x-2">
          <svg class="w-4 h-4 text-[#22C55E]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <span>CMS Activity Audit Log</span>
        </h3>

        <div class="space-y-2.5 overflow-y-auto max-h-[600px] custom-scrollbar pr-1 text-xs">
          {logs.map((log: any) => (
            <div class="p-3 bg-[#191919] border border-[#343434] rounded-lg">
              <div class="flex items-center justify-between">
                <span class="font-mono text-[11px] font-bold text-[#F5F5F5]">{log.action}</span>
                <span class="text-[10px] text-[#929292] font-mono">{new Date(log.created_at).toLocaleTimeString()}</span>
              </div>
              <p class="text-[11px] text-[#929292] mt-0.5">{log.description}</p>
              <div class="text-[9px] text-[#929292]/70 font-mono mt-1 flex items-center justify-between">
                <span>By: {log.user_id}</span>
                <span>Type: {log.entity_type}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

  </div>

  <script>
    const toast = document.getElementById('status-toast');

    function showToast(msg: string, isError = false) {
      if (!toast) return;
      toast.classList.remove('hidden', 'bg-[#22C55E]/10', 'text-[#22C55E]', 'border-[#22C55E]/30', 'bg-[#EF4444]/10', 'text-[#EF4444]', 'border-[#EF4444]/30');
      if (isError) {
        toast.classList.add('bg-[#EF4444]/10', 'text-[#EF4444]', 'border-[#EF4444]/30');
      } else {
        toast.classList.add('bg-[#22C55E]/10', 'text-[#22C55E]', 'border-[#22C55E]/30');
      }
      toast.textContent = msg;
      setTimeout(() => toast?.classList.add('hidden'), 4000);
    }

    document.querySelectorAll('.rollback-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        if (!id || !confirm('Are you sure you want to rollback to this snapshot? Live site content will be updated immediately.')) return;

        try {
          const res = await fetch('/api/cms/revisions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ revisionId: id }),
          });
          const json = await res.json();
          if (res.ok) {
            showToast('Snapshot restored successfully!');
            setTimeout(() => window.location.reload(), 1000);
          } else {
            showToast(json.error || 'Restore failed', true);
          }
        } catch (err: any) {
          showToast(err.message, true);
        }
      });
    });
  </script>
</AdminLayout>