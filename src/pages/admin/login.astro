---
import { getAdminUserCount, getSessionUser } from '../../lib/auth';
import '../../styles/global.css';

export const prerender = false;

let dbError = false;
let dbErrorMessage = '';

try {
  const adminCount = await getAdminUserCount();
  if (adminCount === 0) {
    return Astro.redirect('/admin/setup');
  }

  const user = await getSessionUser(Astro.cookies);
  if (user) {
    return Astro.redirect('/admin');
  }
} catch (err: any) {
  console.error('[Admin Login Page] Error loading session or admin count:', err);
  dbError = true;
  dbErrorMessage = err.message || 'Database connection error';
}

const urlError = Astro.url.searchParams.get('error');
if (urlError === 'db_error' && !dbError) {
  dbError = true;
  dbErrorMessage = 'Database connection error. Please verify your DATABASE_URL configuration.';
}
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — Portfolio CMS Admin</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#1D1511] text-[#E9DFCF] min-h-screen flex items-center justify-center p-4 antialiased font-sans">
    
    <div class="w-full max-w-md">
      
      <!-- Warm Card -->
      <div class="bg-[#2B1D16] border border-[#E9DFCF]/15 rounded-2xl p-7 sm:p-9 shadow-2xl relative overflow-hidden backdrop-blur-md">
        
        <!-- Top Sage Green Glow Accent -->
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[#9CAF88] to-transparent"></div>

        <!-- Header -->
        <div class="text-center mb-8">
          <div class="w-10 h-10 rounded-xl bg-[#9CAF88] text-[#1D1511] font-black font-mono text-base flex items-center justify-center mx-auto mb-4 shadow-lg shadow-[#9CAF88]/20">
            MB
          </div>
          <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-[#E9DFCF]">PORTFOLIO CMS</h1>
          <p class="text-xs text-[#C9BFAF] mt-1.5">Sign in with your administrator credentials.</p>
        </div>

        <!-- Alert Container -->
        <div id="error-alert" class={`${dbError ? '' : 'hidden'} mb-6 p-3.5 rounded-xl bg-[#D9776A]/10 border border-[#D9776A]/30 text-xs text-[#E9DFCF] font-medium flex items-center space-x-2`}>
          <svg class="w-4 h-4 text-[#D9776A] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          <span id="error-message">{dbErrorMessage}</span>
        </div>

        <!-- Credentials Form -->
        <form id="login-form" class="space-y-4">
          <div>
            <label for="identifier" class="block text-xs font-semibold text-[#E9DFCF] mb-1.5">Username or Email</label>
            <input
              type="text"
              id="identifier"
              name="identifier"
              required
              autocomplete="username"
              placeholder="admin@example.com"
              class="w-full bg-[#1D1511] border border-[#E9DFCF]/15 rounded-xl px-3.5 py-2.5 text-sm text-[#E9DFCF] placeholder-[#C9BFAF]/40 focus:outline-none focus:border-[#9CAF88] transition-colors"
            />
          </div>

          <div>
            <label for="password" class="block text-xs font-semibold text-[#E9DFCF] mb-1.5">Password</label>
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              placeholder="••••••••••••"
              class="w-full bg-[#1D1511] border border-[#E9DFCF]/15 rounded-xl px-3.5 py-2.5 text-sm text-[#E9DFCF] placeholder-[#C9BFAF]/40 focus:outline-none focus:border-[#9CAF88] transition-colors"
            />
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full mt-2 py-3 px-4 bg-[#9CAF88] hover:bg-[#B1C2A0] text-[#1D1511] font-bold text-sm rounded-xl transition-all duration-200 shadow-md shadow-[#9CAF88]/20 flex items-center justify-center space-x-2"
          >
            <span>Sign In to Dashboard</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </button>
        </form>

        <!-- MFA Verification Step (Hidden until triggered) -->
        <form id="mfa-form" class="hidden space-y-4">
          <div class="p-3.5 rounded-xl bg-[#1D1511] border border-[#E9DFCF]/10 text-xs text-[#C9BFAF]">
            Enter the 6-digit verification code from your authenticator app or a single-use recovery code.
          </div>

          <div>
            <label for="mfa-code" id="mfa-label" class="block text-xs font-semibold text-[#E9DFCF] mb-1.5">Authenticator Code (TOTP)</label>
            <input
              type="text"
              id="mfa-code"
              name="mfa-code"
              autocomplete="one-time-code"
              placeholder="000000"
              class="w-full bg-[#1D1511] border border-[#E9DFCF]/15 rounded-xl px-3.5 py-2.5 text-sm text-[#E9DFCF] placeholder-[#C9BFAF]/40 focus:outline-none focus:border-[#9CAF88] transition-colors font-mono tracking-widest text-center text-lg"
            />
          </div>

          <button
            type="submit"
            id="mfa-submit-btn"
            class="w-full mt-2 py-3 px-4 bg-[#9CAF88] hover:bg-[#B1C2A0] text-[#1D1511] font-bold text-sm rounded-xl transition-all duration-200 shadow-md shadow-[#9CAF88]/20 flex items-center justify-center space-x-2"
          >
            <span>Verify & Proceed</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </button>

          <div class="text-center pt-2">
            <button type="button" id="toggle-recovery-btn" class="text-[11px] text-[#C9BFAF] hover:text-[#9CAF88] transition-colors underline">
              Use single-use recovery code
            </button>
          </div>
        </form>

        <div class="mt-8 pt-6 border-t border-[#E9DFCF]/10 flex items-center justify-between text-[11px] text-[#C9BFAF]">
          <a href="/" class="hover:text-[#E9DFCF] transition-colors flex items-center space-x-1">
            <span>←</span>
            <span>Return to Portfolio</span>
          </a>
          <span class="font-mono text-[10px]">AUTH_MODE: SESSION</span>
        </div>

      </div>

    </div>

    <script>
      const loginForm = document.getElementById('login-form') as HTMLFormElement;
      const mfaForm = document.getElementById('mfa-form') as HTMLFormElement;
      const errorAlert = document.getElementById('error-alert') as HTMLDivElement;
      const errorMessage = document.getElementById('error-message') as HTMLSpanElement;
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
      const mfaSubmitBtn = document.getElementById('mfa-submit-btn') as HTMLButtonElement;
      const mfaCodeInput = document.getElementById('mfa-code') as HTMLInputElement;
      const mfaLabel = document.getElementById('mfa-label') as HTMLLabelElement;
      const toggleRecoveryBtn = document.getElementById('toggle-recovery-btn') as HTMLButtonElement;

      let currentMfaToken = '';
      let isUsingRecovery = false;

      loginForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorAlert.classList.add('hidden');
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>Verifying credentials...</span>';

        const identifier = (document.getElementById('identifier') as HTMLInputElement).value;
        const password = (document.getElementById('password') as HTMLInputElement).value;

        try {
          const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ identifier, password }),
          });

          const data = await res.json();

          if (res.ok && data.success) {
            if (data.requiresMfa && data.mfaToken) {
              currentMfaToken = data.mfaToken;
              loginForm.classList.add('hidden');
              mfaForm.classList.remove('hidden');
              mfaCodeInput.focus();
            } else {
              submitBtn.innerHTML = '<span>Redirecting...</span>';
              window.location.href = '/admin';
            }
          } else {
            errorAlert.classList.remove('hidden');
            errorMessage.textContent = data.error || 'Login failed. Please check credentials.';
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Sign In to Dashboard</span>';
          }
        } catch (err) {
          errorAlert.classList.remove('hidden');
          errorMessage.textContent = 'Server connection error. Please try again.';
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<span>Sign In to Dashboard</span>';
        }
      });

      toggleRecoveryBtn?.addEventListener('click', () => {
        isUsingRecovery = !isUsingRecovery;
        if (isUsingRecovery) {
          mfaLabel.textContent = 'Single-Use Recovery Code (e.g. XXXX-XXXX-XXXX)';
          mfaCodeInput.placeholder = 'XXXX-XXXX-XXXX';
          mfaCodeInput.classList.remove('tracking-widest');
          toggleRecoveryBtn.textContent = 'Use 6-digit authenticator code instead';
        } else {
          mfaLabel.textContent = 'Authenticator Code (TOTP)';
          mfaCodeInput.placeholder = '000000';
          mfaCodeInput.classList.add('tracking-widest');
          toggleRecoveryBtn.textContent = 'Use single-use recovery code';
        }
        mfaCodeInput.value = '';
        mfaCodeInput.focus();
      });

      mfaForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorAlert.classList.add('hidden');
        mfaSubmitBtn.disabled = true;
        mfaSubmitBtn.innerHTML = '<span>Validating code...</span>';

        const code = mfaCodeInput.value.trim();

        try {
          const res = await fetch('/api/auth/mfa-verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ mfaToken: currentMfaToken, code }),
          });

          const data = await res.json();

          if (res.ok && data.success) {
            mfaSubmitBtn.innerHTML = '<span>Verified. Entering...</span>';
            window.location.href = '/admin';
          } else {
            errorAlert.classList.remove('hidden');
            errorMessage.textContent = data.error || 'Invalid verification code.';
            mfaSubmitBtn.disabled = false;
            mfaSubmitBtn.innerHTML = '<span>Verify & Proceed</span>';
          }
        } catch (err) {
          errorAlert.classList.remove('hidden');
          errorMessage.textContent = 'Server verification error. Please try again.';
          mfaSubmitBtn.disabled = false;
          mfaSubmitBtn.innerHTML = '<span>Verify & Proceed</span>';
        }
      });
    </script>
  </body>
</html>
